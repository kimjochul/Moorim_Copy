      effectPower: 30
      line: "\uBA85\uC6D4\uC740 \uC6C3\uC73C\uBA70 \uACE0\uAC1C\uB97C \uAE01\uC801\uC784\uC5D0
        \uB530\uB77C  \uC18C\uC6D4\uC740 \uC774\uBBF8 \uB208\uCE58\uCC44\uACE0 \uC788\uC5C8\uB2E4. 
        \uC774 \uB3C8\uC774 \uC815\uC0C1\uC801\uC778 \uBC29\uBC95\uC5D0\uC11C \uB098\uC628\uAC74
        \uC544\uB2C8\uB77C\uB294 \uC0AC\uC2E4\uC744,  \uD5C8\uB098 \uAD6C\uD0DC\uC5EC
        \uC0AC\uC871\uC744 \uBD99\uD788\uC9C4 \uC54A\uC558\uB2E4.  \uADF8\uB798\uBD24\uC790
        \uC77C\uC740 \uC774\uBBF8 \uBC8C\uC5B4\uC84C\uACE0, \uAFB8\uC9C0\uB78C\uC744
        \uD55C\uB4E4 \uBC14\uB00C\uB294\uAC8C \uC5C6\uB2E4\uB294\uAC78  \uBBF8\uB9AC
        \uAE68\uB2EC\uC558\uAE30 \uB54C\uBB38\uC774\uB2E4.  \uB300\uC2E0 \uC8FC\uBC29
        \uCABD\uC73C\uB85C \uAC78\uC5B4\uAC00\uBA70 \uB9D0\uD588\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
