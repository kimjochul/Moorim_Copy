        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\u201C\uC774 \uC218\uB9AC\uBE44\uB294 \uC5B4\uB514\uC11C \uB09C \uAC70\uC57C?
        \uD55C\uB450\uD47C\uC73C\uB860 \uC548\uB410\uC744\uD150\uB370.\u201D"
