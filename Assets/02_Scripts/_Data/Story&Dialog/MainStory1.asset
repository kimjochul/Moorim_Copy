        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uC18C\uC6D4\uC740 \uCC9C\uCC9C\uD788 \uAC1D\uC794\uC744 \uB458\uB7EC\uBCF4\uBA70
        \uB0A0\uCE74\uB86D\uAC8C \uC3D8\uC544\uBD99\uD614\uB2E4."
