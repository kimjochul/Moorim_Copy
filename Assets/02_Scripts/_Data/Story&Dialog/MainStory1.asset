        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uBA85\uC6D4\uC740 \uC62C\uAC8C \uC654\uB2E4\uB294 \uB4EF \uC2DC\uC120\uC744
        \uD558\uB298\uB85C \uB450\uC5C8\uB2E4."
