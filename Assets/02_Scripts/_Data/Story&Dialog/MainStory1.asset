    lines:
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uC804\uC7C1\uC774 \uB05D\uB09C \uC9C0 \uBA87 \uD574\uAC00 \uC9C0\uB09C
        \uC5B4\uB290 \uB0A0 \uBB34\uB9BC\uACFC \uC11C\uBC29\uC744 \uC787\uB294 \uAE38\uBAA9
        \uD55C\uAC00\uC6B4\uB370, \uC624\uB7AB\uB3D9\uC548 \uB2EB\uD600 \uC788\uB358
        \uAC1D\uC794 \uD558\uB098\uAC00 \uB2E4\uC2DC \uBB38\uC744 \uC5F4\uC5C8\uB2E4.\r\n\uC774\uB984\uD558\uC5EC
        **\uBB34\uB9BC\uAC1D\uC794**."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uD55C\uB54C \uC5EC\uD589\uC790\uB4E4\uACFC \uBB34\uB9BC\uC778\uB4E4\uB85C
        \uBD90\uBE44\uB358 \uACF3\uC774\uC5C8\uC9C0\uB9CC, \uC804\uC7C1\uC774 \uC9C0\uB098\uAC04
        \uB4A4 \uAC74\uBB3C\uC758 \uC808\uBC18\uC774 \uBB34\uB108\uC84C\uACE0 \uC0AC\uB78C\uB4E4\uC740
        \uB2E4\uC2DC\uB294 \uC7A5\uC0AC\uB97C \uD560 \uC218 \uC5C6\uC744 \uAC83\uC774\uB77C
        \uC218\uAD70\uAC70\uB838\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uADF8\uB7F0 \uAC1D\uC794\uC758 \uBB38\uC744 \uC791\uC740 \uD310\uB2E4
        \uC218\uC778 \uD558\uB098\uAC00 \uD798\uAECF \uBC00\uC5B4 \uC5F4\uC5C8\uB2E4.\r\n\uBB38\uC774
        \uC5F4\uB9AC\uC790 \uC624\uB7AB\uB3D9\uC548 \uC313\uC5EC \uC788\uB358 \uBA3C\uC9C0\uAC00
        \uD587\uBE5B \uC18D\uC5D0\uC11C \uD769\uB0A0\uB9AC\uBA70, \uBC18\uC9DD\uC778\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\u201C\uD760\u2026 \uC0DD\uAC01\uBCF4\uB2E4 \uBA3C\uC9C0\uAC00 \uB9CE\uB124.\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uAC1D\uC794\uC758 \uD640\uC5D0 \uC11C \uC788\uB294 \uC774\uB294 \uC791\uC740
        \uD0A4\uC758 \uD310\uB2E4 \uC218\uC778, **\uBA85\uC6D4**\uC774\uC5C8\uB2E4.\r\n\uADF8\uB140\uB294
        \uD5C8\uB984\uD55C \uD0C1\uC790\uB97C \uD22D\uD22D \uB450\uB4DC\uB9AC\uBA70
        \uB9D0\uD588\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\u201C\uADF8\uB798\uB3C4 \uBB50, \uC7A5\uC0AC\uB294 \uD560 \uC218 \uC788\uACA0\uC9C0!\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect: 0
      effectDuration: 0.3
      effectPower: 30
      line: "\uAC1D\uC794\uC758 \uC808\uBC18\uC740 \uACA8\uC6B0 \uC218\uB9AC\uB41C
        \uC0C1\uD0DC\uC600\uACE0  \uC758\uC790\uC640 \uD0C1\uC790\uB3C4 \uC5EC\uAE30\uC800\uAE30
        \uAE01\uD788\uACE0 \uB0A1\uC544 \uC788\uC5C8\uB2E4.  \uADF8\uB798\uB3C4 \uBA85\uC6D4\uC740
        \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uD45C\uC815\uC774\uC5C8\uB2E4.  \uADF8 \uB4A4\uC5D0\uC11C
        \uD314\uC9F1\uC744 \uB080 \uCC44 \uC11C \uC788\uB358  \uC870\uAE08 \uB354
        \uD0A4\uAC00 \uD070 \uD310\uB2E4 \uC218\uC778\uC774 \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4. 
        \uADF8\uB140\uC758 \uC774\uB984\uC740 \uC18C\uC6D4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 1.5
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
