        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uADF8\uAC8C \uB124\uAC00 \uC6D0\uD558\uB294 \uACB0\uB9D0\uC774\uB77C\uBA74
        \uAE30\uAEBC\uC774 \uB530\uB77C\uC57C\uACA0\uC9C0.\r\n\uADF8\uB85C \uC778\uD574
        \uC6A9\uC11C\uBC1B\uC744\uC218 \uC788\uB2E4\uBA74.."
