      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "4\uC6D4 12\uC77C, \uC720\uC2DC(\u9149\u6642), \uAC1D\uC794 \uB4A4 \uCCAD\uC6B4\uC0B0
        \uC911\uD131 \uC5BC\uAD74 \uBC14\uC704 \uC55E\uC73C\uB85C."
