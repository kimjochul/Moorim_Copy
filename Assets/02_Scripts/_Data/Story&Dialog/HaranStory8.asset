      line: "\uADF8 \uC138\uC6D4\uC18D\uC5D0 \uAC07\uD600 \uBC84\uB465\uAC70\uB9AC\uBA70.
        \uB0B4\uAC00 \uCD08\uB798\uD55C \uACB0\uB9D0\uC5D0 \uC228\uC774 \uB9C9\uD78C\uCC44\uB85C
        \uC775\uC0AC\uD558\uB294\uAD6C\uB098."
      useTypingSound: 1
