      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uC5B4\uCA4C\uBA74 \uD568\uC815\uC77C\uC9C0\uB3C4 \uBAA8\uB978\uB2E4.\r\n\uC8FC\uBCC0\uC5D0
        \uB9F9\uC758 \uC218\uC0AC\uAD00\uB4E4\uC774 \uC7A0\uBCF5\uD574\uC11C \uB0A0
        \uC77C\uC81C\uD788 \uD3EC\uBC15\uD560\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uADF8\uB807\uAC8C \uB41C\uB2E4\uBA74 \uB09C \uAF3C\uC9DD\uC5C6\uC774
        \uBD99\uC7A1\uD600 \uCC98\uD615\uB2F9\uD558\uAC8C \uB418\uACA0\uC9C0.\r\n\uBC31\uB144\uB300\uACC4\uAC00
        \uB208 \uC55E\uC5D0 \uC788\uB294\uB9CC\uD07C \uBD88\uD655\uC2E4\uC131\uC5D0
        \uC0AC\uD65C\uC744 \uAC78 \uD544\uC694\uB3C4 \uC5C6\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uD558\uC9C0\uB9CC \uB10C \uB0B4\uAC00 \uB124 \uB9D0\uC744 \uAC70\uC5ED\uD560
        \uC218 \uC5C6\uB2E4\uB294 \uAC78 \uC54C\uAE30\uC5D0\r\n\uC774\uAC78 \uBCF4\uB0B8\uAC70\uACA0\uC9C0."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
