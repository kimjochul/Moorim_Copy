      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: " \uC54C\uACE0 \uC788\uC5C8\uC5B4. \uCD5C\uC120\uC774 \uC544\uB0D0. \uC2E4\uC0C1\uC740
        \uADF8\uB0E5 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uACE0 \uC2F6\uC740 \uB0B4
        \uC790\uC2E0\uB9CC\uC774 \uC788\uC5C8\uC744 \uBFD0\uC774\uC57C."
