      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uC544\uBB34\uAC83\uB3C4 \uACB0\uC815\uD558\uC9C0 \uC54A\uB294\uAC83\uC870\uCC28
        \uACB0\uC815\uC774\uB77C\uB294\uAC78 \uB108\uBB34 \uB2A6\uAC8C \uAE68\uB2EC\uC558\uC5B4.\r\n\uBAA8\uB4E0\uAC78
        \uC783\uACE0 \uB098\uC11C\uC57C \uB545\uC744 \uCE58\uACE0 \uD6C4\uD68C\uD558\uBA70
        \uCD94\uD6C4\uC5D0 \uB610 \uAC19\uC740 \uC120\uD0DD\uC744 \uD588\uC9C0."
