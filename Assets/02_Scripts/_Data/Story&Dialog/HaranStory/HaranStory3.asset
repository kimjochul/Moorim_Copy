      line: "\uC0AC\uB78C\uB4E4\uC740 \uC785\uC744 \uBAA8\uC544 \uCE6D\uC1A1\uD588\uC2B5\uB2C8\uB2E4.\r\n\u201C\uC5C6\uB294
