  m_Script: {fileID: 11500000, guid: 609142ec797450f429543e3dfca29176, type: 3}
  m_Name: HaranStory5
  m_EditorClassIdentifier: Assembly-CSharp::Story
  id: 15
  storyName: "5. \uB099\uD654\uC720\uC218"
  description: "\uC2ED\uC5EC \uB144 \uC804, \uD558\uB780\uACFC \uC18C\uC6D4\uC774
    \uC11C\uB85C \uB9CC\uB0AC\uC744 \uB54C\uBD80\uD130 \uC18C\uC6D4\uC740 \uD558\uB780\uC5D0\uAC8C
    \uB2E4\uAC00\uAC14\uACE0 \uB458\uC740 \uCE5C\uAD6C\uAC00 \uB410\uB2E4.\n\n\uB458\uC740
    \uC6C5\uBB18\uB2F9\uC8FC\uC758 \uB9CC\uB450\uB97C \uD6D4\uCCD0\uBA39\uB2E4 \uD63C\uB098\uAE30\uB3C4
    \uD558\uACE0 \uC0AC\uACFC\uBC2D\uC744 \uC11C\uB9AC\uD558\uAE30\uB3C4 \uD558\uB294
    \uB4F1 \uC7A5\uB09C\uC744 \uAC19\uC774 \uCE58\uB294 \uCE5C\uAD6C \uC0AC\uC774\uC600\uB2E4.\n\n\uB458\uC740
    \uB9E4\uC77C \uD56D\uC0C1 \uC9D1 \uB4A4\uCABD \uB098\uBB34\uC5D0\uC11C \uC2DC\uAC04\uC744
    \uBCF4\uB0C8\uB2E4.\n\n\uBA87 \uB144\uC744 \uC18C\uC6D4\uACFC \uC9C0\uB0B4\uB2E4
    \uBCF4\uB2C8, \uC774\uC804\uC5D0\uB294 \uADF8\uC800 \uBCC4\uC758\uBBF8 \uC5C6\uB294
    \uAE30\uB85D\uC774\uC5C8\uB358 \uC77C\uAE30\uAC00 \uC774\uC81C\uB294 \uC18C\uC6D4\uC5D0
    \uB300\uD55C \uAE30\uB85D\uB4E4\uB85C \uCC44\uC6CC\uC838\uC788\uC5C8\uB2E4.\n\n\uC18C\uC6D4\uC758
    \uAC10\uC815\uB4E4, \uB208\uBE5B, \uD589\uB3D9.\n\n\uD558\uB780\uC758 \uB9C8\uC74C\uC5D0\uB294
    \uC18C\uC6D4\uC774 \uC628\uC804\uD788 \uB4E4\uC5B4\uC640 \uC788\uC5C8\uB2E4.\n\n\uCCAD\uC18C\uB144\uC774
    \uB418\uC5B4\uB3C4 \uB458\uC740 \uC5EC\uC804\uD788 \uC9D1 \uB4A4\uC758 \uB098\uBB34\uC5D0
    \uBAA8\uC5EC\uC11C \uB180\uC558\uB2E4.\n\n\uB458\uC740 \uC5EC\uC804\uD788 \uB9CC\uB450\uB97C
    \uD6D4\uCCD0\uBA39\uAE30\uB3C4, \uC0C8\uB85C\uC6B4 \uC7A5\uB09C\uAC10\uC744 \uAC16\uACE0
    \uB180\uAE30\uB3C4, \uACFC\uC77C\uC744 \uC11C\uB9AC\uD558\uAE30\uB3C4 \uD55C\uB2E4.\n\n\uACA8\uC6B8\uC5D0\uB294
    \uC548 \uCDA5\uB2E4\uACE0 \uBC84\uD2F0\uB294 \uC18C\uC6D4\uC758 \uBAA9\uC5D0
    \uBAA9\uB3C4\uB9AC\uB97C \uB458\uB7EC\uC8FC\uAE30\uB3C4 \uD588\uC5C8\uB2E4.\n\n\uC18C\uC6D4\uC740
    \uB9D0\uC740 \uB0C4\uC0C8\uB09C\uB2E4\uACE0 \uD558\uBA74\uC11C\uB3C4 \uC5BC\uAD74\uC740
    \uBD89\uC5B4\uC84C\uC5C8\uB2E4.\n\n\uB458\uC740 \uC5EC\uB7EC \uACC4\uC808\uC774
    \uC9C0\uB0A0 \uB3D9\uC548 \uB9CE\uC740 \uCD94\uC5B5\uC744 \uC313\uC558\uB2E4.\n\n\uB458\uC740
    \uC5F0\uC778\uC740 \uC544\uB2C8\uC9C0\uB9CC \uAC00\uAE4C\uC6B4 \uCE5C\uAD6C\uC0AC\uC774\uB85C
    \uC9C0\uB0C8\uACE0 \uD558\uB780\uC740 \uC774 \uAD00\uACC4\uAC00 \uACC4\uC18D
    \uC9C0\uC18D\uB420 \uC218 \uC788\uC744 \uAC83\uC774\uB77C\uACE0 \uBBFF\uC5C8\uB2E4.\n\n\n\uD558\uC9C0\uB9CC,
    \uC5B4\uB290\uB367 \uB458\uC740 \uCCAD\uB144\uC774 \uB418\uC5C8\uACE0 \uC18C\uC6D4\uC774
    \uB2F9\uC8FC \uD6C4\uACC4\uC790\uAC00 \uB418\uBA74\uC11C \uBC14\uB00C\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n\uC774\uC81C
    \uC18C\uC6D4\uC740 \uB098\uBB34\uC5D0\uC11C \uB180 \uC2DC\uAC04\uC744 \uB0BC
    \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uBC14\uC060 \uC608\uC815\uC774\uC5C8\uB2E4.\n\n\uADF8\uB7F0
    \uC18C\uC6D4\uC5D0\uAC8C \uD558\uB780\uC740 \uC544\uBB34\uB9D0\uB3C4 \uBABB \uD588\uB2E4.\n\n\uC5B8\uC81C
    \uBCFC \uC218 \uC788\uB294\uC9C0 \uBB3B\uC9C0 \uBABB \uD588\uACE0, \uC18C\uC6D4\uC5D0
    \uB300\uD55C \uC790\uC2E0\uC758 \uBCF5\uC7A1\uD55C \uB9C8\uC74C\uC744 \uACE0\uBC31\uD558\uC9C0\uB3C4
    \uC54A\uC558\uB2E4.\n\n\uD558\uB780\uC740 \uC544\uBB34 \uAC83\uB3C4 \uC548 \uD558\uACE0
    \uBA48\uCDB0\uC788\uB294 \uBCF8\uC778\uC5D0\uAC8C \uC18C\uC6D4\uC774 \uC5BD\uBA54\uC774\uC9C0
    \uC54A\uC558\uC73C\uBA74 \uD588\uB2E4.\n\n\uC18C\uC6D4\uC774 \uC5C6\uC774 \uD558\uB780\uC740
    \uBA87 \uAC8C\uC808\uC744 \uBCF4\uB0C8\uB2E4.\n\n\uD558\uB780\uC5D0\uAC8C \uC18C\uC6D4\uC774
    \uC5C6\uC774 \uBCF4\uB0B4\uB294 \uC2DC\uAC04\uC740 \uC0AD\uB9C9\uD588\uB2E4.\n\n\uC18C\uC6D4\uC740
    \uC624\uC9C0 \uC54A\uB294\uB2E4\uB294 \uAC83\uC744 \uC54C\uACE0 \uC788\uC5B4\uB3C4
    \uC608\uC804\uC5D0 \uC18C\uC6D4\uC774 \uC654\uB358 \uC2DC\uAC04\uC5D0\uB294 \uAD1C\uC2DC\uB9AC
    \uB9C8\uC74C\uC774 \uB4E4\uB728\uB2E4\uAC00 \uACB0\uAD6D \uD63C\uC790\uC11C \uB458\uC758
    \uCD94\uC5B5\uC744 \uD63C\uC790 \uB418\uC0C8\uAE30\uAE30\uB9CC \uD588\uB2E4.\n\n\uB2E4\uC74C
    \uD574\uC5D0\uB294 \uB098\uBB34 \uC606\uC5D0 \uC18C\uC6D4\uC774 \uD56D\uC0C1
    \uC788\uC5C8\uB358 \uC790\uB9AC\uC5D0 \uC549\uC544\uC11C \uCC45\uC744 \uBCF4\uAE30
    \uC2DC\uC791\uD588\uB2E4.\n\n\uC18C\uC6D4\uC5D0 \uB300\uD55C \uC0DD\uAC01\uC744
    \uD558\uBA74\uC11C \uACBD\uC601\uC5D0 \uAD00\uB828\uB41C \uCC45\uC744 \uC77D\uC73C\uB2C8
    \uC18C\uC6D4\uC774 \uAC19\uC774 \uC788\uB294 \uB290\uB08C\uC774 \uB4E4\uC5B4
    \uAE30\uBD84\uC774 \uC88B\uC558\uB2E4.\n\n\uC18C\uC6D4\uC774 \uB2F9\uC8FC \uD6C4\uACC4\uC790\uB85C\uC368
    \uACF5\uBD80\uB97C \uD558\uBA74\uC11C \uC77D\uC744 \uBC95\uD55C \uCC45\uB4E4\uC744
    \uC77D\uC73C\uBA74\uC11C \uC5B8\uC820\uAC00 \uB9CC\uB0A0 \uB54C \uAC19\uC740
    \uAD00\uC2EC\uC0AC\uB85C \uB300\uD654\uB97C \uD560 \uC218 \uC788\uC744 \uAC83\uC774\uB77C\uACE0
    \uC0DD\uAC01\uD558\uB2C8 \uB450\uADFC\uB450\uADFC \uAC70\uB838\uB2E4.\n\n\uC2DC\uAC04\uC774
    \uC9C0\uB098\uB2C8 \uD558\uB780\uC740 \uCC45\uBC8C\uB808\uAC00 \uB3FC\uC788\uC5C8\uB2E4.\n\n\uD63C\uC790\uC788\uC744
    \uD558\uB780\uC744 \uC0DD\uAC01\uD574 \uAC00\uB054\uC529 \uBA85\uC6D4\uC774 \uCC3E\uC544\uC654\uB2E4.\n\n\uBA85\uC6D4\uACFC
    \uCC45\uC5D0 \uB300\uD55C \uC774\uC57C\uAE30\uB97C \uB098\uB204\uB358 \uD558\uB780\uC740
    \uBCF8\uC778\uC774 \uCC45\uC774 \uC88B\uC544\uC11C \uACF5\uBD80\uAC00 \uC88B\uC544\uC11C
    \uCC45\uC744 \uC77D\uC740 \uAC83\uC774 \uC544\uB2C8\uB77C \uC18C\uC6D4\uC744
    \uC88B\uC544\uD574\uC11C \uC18C\uC6D4\uACFC \uAC19\uC774 \uC788\uACE0 \uC2F6\uC740
    \uB9C8\uC74C\uC5D0 \uCC45\uC744 \uC77D\uACE0 \uC788\uC5C8\uB2E4\uB294 \uAC83\uC744
    \uAE68\uB2EC\uC558\uB2E4.\n\n\uC790\uC2E0\uC758 \uB9C8\uC74C\uC744 \uAE68\uB2EC\uC740
    \uD558\uB780\uC740 \uC18C\uC6D4\uC5D0\uAC8C \uBCF8\uC778\uC758 \uB9C8\uC74C\uACFC
    \uACE0\uBC31\uC744 \uB2F4\uC740 \uD3B8\uC9C0\uB97C \uC801\uC5C8\uB2E4.\n\n\uC624\uB79C\uB9CC\uC5D0
    \uC18C\uC6D4\uC774 \uB098\uBB34\uC5D0 \uCC3E\uC544\uC654\uB2E4.\n\n\uD558\uB780\uC740
    \uC804\uACFC \uAC19\uC740 \uC18C\uC6D4\uC758 \uBAA8\uC2B5\uC5D0 \uB208\uBB3C\uC774
    \uB0A0 \uAC70 \uAC19\uC740 \uAE30\uBD84\uC774 \uB4E4 \uC815\uB3C4\uC600\uB2E4.\n\n\uD558\uB780\uC740
    \uACE0\uBC31 \uD3B8\uC9C0\uB97C \uC804\uD558\uAE30\uB85C \uB9C8\uC74C \uBA39\uC5C8\uC9C0\uB9CC,
    \uB73B \uBC16\uC5D0\uB3C4 \uC18C\uC6D4\uC774 \uC804\uD55C \uB9D0\uC740 \uBCF8\uC778\uC774
    \uB9F9\uC5D0 \uC18D\uD55C \uAC80\uAC00\uC758 \uC790\uC81C\uC640 \uC815\uB7B5
    \uACB0\uD63C\uC744 \uD560 \uC608\uC815\uC774\uB77C\uB294 \uAC83\uC774\uC5C8\uB2E4.\n\n\uD558\uB780\uC740
    \uC18C\uC6D4\uC744 \uC88B\uC544\uD55C\uB2E4\uB294 \uB9C8\uC74C\uC744 \uB2A6\uAC8C
    \uAE68\uB2EC\uC544 \uAE34 \uC2DC\uAC04\uC744 \uAC19\uC774 \uC9C0\uB0C8\uC5B4\uB3C4
    \uACB0\uAD6D \uACE0\uBC31\uC744 \uBABB\uD558\uACE0 \uB193\uCE5C \uAE30\uD68C\uB97C
    \uC544\uC26C\uC6CC\uD588\uACE0, \uC18C\uC6D4\uC5D0\uAC8C \uACE0\uBC31\uD574 \uB9E4\uB2EC\uB9AC\uC9C0\uB3C4
    \uC54A\uC558\uB2E4.\n\n\uD558\uB780\uC740 \uC18C\uC6D4\uC774 \uBCF8\uC778\uC758
    \uACE0\uBC31\uC73C\uB85C \uC778\uD574 \uC8C4\uCC45\uAC10\uC744 \uAC00\uC9C4 \uCC44
    \uACB0\uD63C\uC744 \uD558\uB294 \uAC83\uC744 \uC6D0\uCE58 \uC54A\uC558\uACE0
    \uB9C8\uC74C \uC5C6\uB294 \uCD95\uD558\uB97C \uC804\uD588\uB2E4.\n\n\uADF8\uB7F0
    \uD558\uB780\uC5D0\uAC8C \uC18C\uC6D4\uC740 \uD55C\uC2EC\uD558\uB2E4\uB294 \uB4EF
    \uC695\uC744 \uBC49\uACE0 \uB3CC\uC544\uAC14\uB2E4.\n\n\uD558\uB780\uC740 \uC790\uC2E0\uC758
    \uC0AC\uB791\uACFC \uACE0\uBC31\uD574\uBCF4\uC9C0\uB3C4 \uBABB \uD55C \uC544\uD514\uC744
    \uB9C8\uC74C\uC5D0 \uBB3B\uC740 \uCC44 \uD3B8\uC9C0\uB97C \uB098\uBB34 \uC606\uC5D0
    \uBB3B\uC5C8\uB2E4.\n\n\uADF8\uB9AC\uACE0 \uC790\uC2E0\uC758 \uC9C4\uC2EC\uC744
    \uB2F4\uC544 \uB9C8\uC74C\uC18D\uC73C\uB85C \uC18C\uC6D4\uC758 \uD589\uBCF5\uC744
    \uCD95\uBCF5\uD588\uB2E4."
