--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 609142ec797450f429543e3dfca29176, type: 3}
  m_Name: HaranStory8
  m_EditorClassIdentifier: Assembly-CSharp::Story
  id: 18
  storyName: "8. \uC218\uAD6C\uCD08\uC2EC"
  description: "\uD3B8\uC9C0\uC5D0\uB294 \uC2DC\uAC04\uACFC \uC7A5\uC18C\uB85C \uB098\uC624\uB77C\uB294
    \uAE00\uC774 \uC788\uC5C8\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uC7A5\uC18C\uB294
    \uD568\uC815\uC774\uACE0 \uB9F9\uC5D0 \uCCB4\uD3EC\uB2F9\uD558\uB294 \uAC83\uC740
    \uC544\uB2D0\uAE4C, \uCCB4\uD3EC\uB2F9\uD558\uBA74 \uC77C\uC744 \uC2DC\uD589\uD558\uC9C0\uB3C4
    \uBABB\uD558\uACE0 \uCC98\uD615\uB2F9\uD558\uAC8C \uB418\uB294 \uAC83\uC740 \uC544\uB2D0\uC9C0
    \uAC71\uC815\uD588\uC9C0\uB9CC, \uD558\uB780\uC740 \uC18C\uC6D4\uC758 \uB9D0\uC744
    \uAC70\uC5ED\uD560 \uC218 \uC5C6\uC5C8\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uC900\uBE44
    \uC911\uC778 \uC77C\uACFC \uAC19\uC774 \uB73B\uC744 \uD558\uB294 \uC0AC\uB78C\uB4E4\uC774
    \uAC71\uC815\uB410\uC9C0\uB9CC, \uD558\uB780\uC5D0\uAC8C\uB294 \uC18C\uC6D4\uC5D0\uAC8C
    \uC6A9\uC11C\uBC1B\uB294 \uC77C\uC774 \uBB34\uC5C7\uBCF4\uB2E4 \uC911\uC694\uD588\uB2E4.\r\n\r\n\uD558\uB780\uC740
    \uD3B8\uC9C0 \uC18D\uC5D0 \uC801\uD78C \uC7A5\uC18C\uB85C \uC774\uB3D9\uD588\uB2E4.\r\n\r\n\r\n\uC7A5\uC18C\uC5D0
    \uB3C4\uCC29\uD558\uC790 \uC18C\uC6D4\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC5C8\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uD558\uB780\uC758 \uAC70\uC0AC\uB97C \uB9C9\uB294 \uAC83\uC774 \uC544\uB2CC
    \uD558\uB780\uC774 \uC5B4\uB5A4 \uC0AC\uB78C\uB4E4\uACFC \uB9CC\uB098\uAC8C \uD574\uC8FC\uAE30
    \uC704\uD574 \uBD80\uB978 \uAC83\uC774\uC5C8\uB2E4.\r\n\r\n\uAC1D\uC794\uC744
    \uC6B4\uC601\uD558\uBA74\uC11C \uC18C\uC6D4\uC740 \uC6C5\uBB18\uB2F9 \uADF8\uB9AC\uACE0
    \uD558\uB780\uACFC \uAD00\uB828\uC774 \uC788\uC5C8\uB358 \uC0AC\uB78C\uB4E4\uC744
    \uB9CC\uB098\uAC70\uB098 \uAD00\uB828\uB41C \uC18C\uBB38\uB4E4\uC744 \uC811\uD560
    \uC218 \uC788\uC5C8\uB2E4.\r\n\r\n\uADF8\uB4E4\uC740 \uBE44\uB85D \uADC0\uC591\uAE38\uC5D0
    \uC62C\uB790\uC9C0\uB9CC, \uD558\uB780\uC744 \uBBF8\uC6CC\uD558\uAE30\uB294\uCEE4\uB155
    \uAC71\uC815\uD558\uACE0 \uC788\uC5C8\uB2E4.\r\n\r\n\uADF8\uB9AC\uACE0 \uD558\uB780
    \uC55E\uC5D0 \uB2E4\uC12F \uBA85\uC758 \uC0AC\uB78C\uC774 \uBAA8\uC2B5\uC744
    \uB4DC\uB7EC\uB0C8\uB2E4.\r\n\r\n\uAC70\uB798\uCC98\uB97C \uC18C\uAC1C\uD574
    \uC8FC\uB358 \uC950 \uB3C4\uC724 \uC544\uC800\uC528, \uC5B4\uBD80 \uACF0 \uAC15\uD0DC\uACE4
    \uC544\uC800\uC528, \uB300\uC7A5\uC7A5\uC774 \uC624\uC18C\uB9AC \uC6B4\uB3C4,
    \uD654\uC7A5\uD488 \uB2E8\uACE8\uC190\uB2D8 \uACF5\uC791\uC0C8 \uC18C\uB780\uAE4C\uC9C0
    \uADF8\uB4E4\uC740 \uD558\uB780\uC5D0\uAC8C \uC6D0\uB9DD\uC758 \uB9D0\uC744 \uAEBC\uB0B4\uB294
    \uAC83\uC774 \uC544\uB2C8\uB77C \uC61B\uB0A0\uCC98\uB7FC \uC77C\uC0C1\uC801\uC778
    \uB9D0\uC744 \uD574\uC8FC\uAC70\uB098 \uAC71\uC815\uC758 \uB9D0\uC744 \uD574\uC904
    \uBFD0\uC774\uC5C8\uB2E4.\r\n\r\n\uACF5\uC608\uD488\uC744 \uB9CC\uB4E4\uB358
    \uC1A1\uACE8\uB9E4 \uC740\uC124\uC740 \uC7AC\uC0B0\uC744 \uC555\uB958\uB2F9\uD588\uC9C0\uB9CC,
    \uD558\uB780\uC740 \uC11C\uBC29\uC73C\uB85C \uAC00\uC11C \uC0AC\uAC74\uC758 \uC9C4\uC0C1\uC744
    \uBB3C\uC5B4\uBCF4\uC9C0\uB3C4 \uBABB\uD588\uB2E4\uACE0 \uC774\uC57C\uAE30\uD588\uB2E4.\r\n\r\n\uC740\uC124\uC740
    \uC815\uB9D0 \uAE08\uD638\uB2F9\uC774 \uD63C\uC790 \uC8FD\uAE30 \uC2EB\uC5B4\uC11C
    \uB2E4\uB978 \uB2F9\uC5D0 \uB204\uBA85\uC744 \uC50C\uC6B4 \uAC83\uC774 \uB9DE\uB0D0\uACE0
    \uBB3C\uC5B4\uBCF4\uC558\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uACE0\uBBFC\uD558\uACE0
    \uC18D\uC73C\uB85C \uC0DD\uAC01\uD588\uB2E4.\r\n\r\n\uADF8 \uC77C\uC740 \uB458\uC9F8
    \uC14B\uC9F8\uAC00 \uBAB0\uB798 \uBB34\uACF5\uC11C\uB97C \uBC18\uCD9C\uD574\uC11C
    \uC0DD\uAE34 \uC77C\uC774\uB77C\uACE0, \uB098\uB294 \uB9D0\uB824\uB3C4 \uC758\uBBF8\uAC00
    \uC5C6\uC73C\uB2C8 \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\uACE0,\r\n\r\n\uD558\uC9C0\uB9CC
    \uC774\uAC74 \uC2DC\uB3C4\uC870\uCC28 \uD558\uC9C0 \uC54A\uC740 \uBCC0\uBA85\uC774\uC5C8\uB2E4.\r\n\r\n\uB098\uB294
    \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uACE0 \uC804\uBD80 \uAC00\uBB38\uC5D0\uC11C
    \uC815\uD55C \uC77C\uC774\uB2E4, \uB098\uB3C4 \uC870\uC0AC\uBC1B\uC744 \uB54C
    \uC54C\uC558\uB2E4, \uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC5C6\uC5C8\uB2E4,\r\n\r\n\uC774\uAC70\uB294
    \uC644\uC804\uD55C \uAC70\uC9D3\uB9D0\uC774\uC5C8\uB2E4.\r\n\r\n\uC18D\uC73C\uB85C
    \uACE0\uBBFC\uD558\uB294 \uC911 \uC5B4\uB9B0 \uBAA8\uC2B5\uC758 \uD558\uB780\uC774
    \uB9D0\uC744 \uAC70\uB294 \uB4EF\uD588\uB2E4.\r\n\r\n\uB108\uB294 \uD56D\uC0C1
    \uC2A4\uC2A4\uB85C \uD0C0\uC77C\uB7EC\uC654\uC744 \uBFD0\uC774\uB77C\uACE0, \uACE0\uBBFC\uC744
    \uD574\uBCF8 \uC801\uC740 \uD55C \uBC88\uB3C4 \uC5C6\uC774 \uC2A4\uC2A4\uB85C
    \uD569\uB9AC\uD654\uD558\uACE0 \uACB0\uC815\uD574 \uBC84\uB838\uB2E4\uACE0, \uD56D\uC0C1
    \uC2A4\uC2A4\uB85C \uBCF4\uACE0 \uC2F6\uC740 \uB300\uB85C\uB9CC \uBCF4\uACE0
    \uACB0\uACFC\uB97C \uC608\uCE21\uD558\uACE0 \uCCB4\uB150\uD558\uACE0 \uD569\uB9AC\uD654\uD55C\uB2E4\uACE0,\r\n\r\n\uD56D\uC0C1
    \uADF8\uB798 \uC654\uB4EF \uCE68\uBB35\uD558\uACE0 \uB3C4\uB9DD\uAC00\uC11C \uAC70\uC0AC\uB97C
    \uC800\uC9C0\uB974\uACE0 \uBE44\uCC38\uD55C \uCD5C\uD6C4\uB97C \uB9DE\uB294 \uAC8C
    \uC18D\uC8C4\uD560 \uBC29\uBC95\uC774\uB77C\uACE0.\r\n\r\n\uD558\uB780\uC740
    \uC774\uC81C\uC57C \uC99D\uC5B8\uACFC \uCE68\uBB35\uC758 \uC120\uD0DD\uC5D0\uC11C
    \uD68C\uD53C\uB97C \uD0DD\uD55C \uAC83\uC740 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0
    \uC54A\uC740 \uAC83\uC774 \uC544\uB2C8\uB77C \uCE68\uBB35\uC744 \uC120\uD0DD\uD588\uB2E4\uB294
    \uAC83\uC784\uC744 \uAE68\uB2EC\uC558\uB2E4.\r\n\r\n\uC8C4\uCC45\uAC10\uC5D0
    \uC790\uC2E0\uC744 \uC2A4\uC2A4\uB85C \uAC00\uB450\uC5C8\uB358 \uD558\uB780\uC740
    \uC18C\uC6D4\uC5D0 \uB300\uD55C \uBCF8\uC778\uC758 \uB9C8\uC74C\uC744 \uC228\uACA8\uC11C
    \uBAA8\uB4E0 \uAC83\uC744 \uC783\uACE0 \uD6C4\uD68C\uB97C \uD588\uC74C\uC5D0\uB3C4
    \uC99D\uC5B8 \uB300\uC2E0 \uCE68\uBB35\uC744 \uD0DD\uD558\uB294 \uAC19\uC740
    \uD68C\uD53C\uC758 \uC120\uD0DD\uC744 \uB610 \uD588\uB2E4.\r\n\r\n\uC5B4\uB9B0
    \uBAA8\uC2B5\uC758 \uD558\uB780\uC740 \uB2E4\uC2DC \uD558\uB780 \uB108\uB294
    \uC6D0\uB798 \uADF8\uB7F0 \uBD80\uB958\uC758 \uC0AC\uB78C\uC774\uB77C\uACE0 \uBD80\uCD94\uACBC\uB2E4.\r\n\r\n\uD558\uB780\uC740
    \uCCB4\uB150\uD558\uACE0, \uB3C4\uB9DD\uCCD0\uC11C \uAC70\uC0AC\uB97C \uC2E4\uD589\uD558\uC790\uACE0
    \uC0DD\uAC01\uD588\uB2E4.\r\n\r\n\uADF8\uB7F0 \uD558\uB780\uC744 \uBD99\uC7A1\uC740
    \uC0AC\uB78C\uC740 \uC18C\uC6D4\uC774\uC5C8\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uD558\uB780\uC5D0\uAC8C \uC774\uC81C\uB294 \uC0DD\uAC01\uB9CC \uD558\uC9C0 \uB9D0\uACE0
    \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC744 \uD574\uC11C \uB54C\uB97C \uB193\uCE58\uC9C0
    \uB9D0\uB77C\uACE0 \uC870\uC5B8\uD588\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uC6A9\uC11C\uBC1B\uC744
    \uC218 \uC788\uC744\uC9C0, \uBC1B\uC544\uB3C4 \uB418\uB294\uC9C0 \uBD88\uC548\uD55C
    \uB9C8\uC74C\uC744 \uB0B4\uB193\uAE30 \uC2DC\uC791\uD588\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uB9D0\uC740 \uD45C\uD604\uD574\uC57C \uC54C \uC218 \uC788\uB2E4\uACE0 \uD558\uACE0
    \uC2F6\uC740 \uB9D0\uC774 \uBB34\uC5C7\uC778\uC9C0 \uB2E4\uC815\uD558\uAC8C \uB2E4\uC2DC
    \uD55C\uBC88 \uBB3C\uC5C8\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uBA38\uBB47\uAC70\uB9AC\uBA74\uC11C
    \uBAA8\uB450\uC5D0\uAC8C \uBCF8\uC778\uC758 \uB9C8\uC74C\uC744 \uD138\uC5B4\uB193\uAE30
    \uC2DC\uC791\uD588\uB2E4.\r\n\r\n\uBBF8\uC548\uD558\uB2E4\uACE0, \uBAA8\uB974\uB294
    \uCC99\uD588\uB2E4\uACE0, \uAC10\uB2F9\uC744 \uBABB\uD560 \uAC70 \uAC19\uC544\uC11C
    \uB3C4\uB9DD\uCCE4\uB2E4\uACE0, \uBAA8\uB450\uB97C \uC2E4\uB9DD\uD558\uAC8C \uD588\uB2E4\uACE0,
    \uBBF8\uC548\uD558\uB2E4\uACE0, \uBB34\uC11C\uC6E0\uB2E4\uACE0...\r\n\r\n\uD0DC\uACE4,
    \uC18C\uB780, \uC6B4\uB3C4, \uC740\uC124, \uB3C4\uC724 \uBAA8\uB450 \uD558\uB780\uC758
    \uC9C4\uC2EC\uC740 \uC774\uBBF8 \uC54C\uACE0 \uC788\uC5C8\uC744 \uAC83\uC774\uB2E4.\r\n\r\n\uD558\uB780\uC774
    \uB3C4\uC640\uC92C\uB358 \uC77C, \uD558\uB780\uC758 \uB530\uB4EF\uD55C \uB9C8\uC74C\uC744
    \uB9D0\uD574\uC8FC\uBA74\uC11C \uBAA8\uB450\uB294 \uD558\uB780\uC744 \uC6A9\uC11C\uD574
    \uC8FC\uC5C8\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uC6B8\uC5C8\uACE0 \uBAA8\uB450
    \uD558\uB780\uC744 \uB04C\uC5B4\uC548\uC558\uB2E4.\r\n\r\n\uD558\uB780\uC740
    \uC8C4\uCC45\uAC10\uACFC \uADFC\uC2EC\uC73C\uB85C \uB3C4\uB9DD\uCCE4\uC5C8\uC9C0\uB9CC,
    \uC774\uC81C\uB294 \uADF8\uB9AC\uC6E0\uB358 \uACE0\uD5A5\uC5D0\uC11C \uBCF8\uC778\uC774
    \uC0AC\uB791\uD588\uB358 \uC774\uB4E4\uACFC \uD568\uAED8\uD558\uBA70 \uADFC\uC2EC
    \uC5C6\uB294 \uD3B8\uC548\uD55C \uC7A0\uC744 \uC774\uB8F0 \uC218 \uC788\uAC8C
    \uB418\uC5C8\uB2E4.\r\n\r\n\r\n\uC18C\uC6D4\uACFC \uD558\uB780\uC740 \uB458\uC774\uC11C
    \uB9F9\uC758 \uCD95\uC81C\uB97C \uBC14\uB77C\uBCF4\uACE0 \uC788\uB2E4.\r\n\r\n\uD558\uB780\uC740
    \uAC70\uC0AC\uB97C \uBA48\uCD94\uAE30\uB85C \uACB0\uC815\uD588\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uC6C3\uC73C\uBA74\uC11C \uC7AC\uBC0C\uB294 \uBB3C\uAC74\uC744 \uAC00\uC838\uC654\uB2E4\uBA70
    \uD55C \uBB3C\uAC74\uC744 \uAEBC\uB0C8\uB2E4.\r\n\r\n\uC18C\uC6D4\uC774 \uAEBC\uB0B8
    \uBB3C\uAC74\uC740 \uD558\uB780\uC774 \uC804\uD558\uC9C0 \uBABB\uD588\uB358 \uD558\uB780\uC758
    \uC9C4\uC2EC\uC744 \uB2F4\uC544 \uC18C\uC6D4\uC5D0\uAC8C \uC8FC\uACE0\uC790 \uD588\uC5C8\uB358
    \uD3B8\uC9C0\uC600\uB2E4.\r\n\r\n\uC9D1 \uB4A4\uC5D0 \uC788\uC5C8\uB358 \uB098\uBB34\uC5D0\uC11C,
    \uC18C\uC6D4\uC740 \uD558\uB780\uC5D0\uAC8C \uD63C\uC57D \uC0AC\uC2E4\uC744 \uB9D0\uD574\uC900
    \uC774\uD6C4 \uB3CC\uC544\uC628 \uB4A4\uC5D0 \uC9D1\uC5D0\uC11C \uD558\uB780\uC774
    \uB098\uBB34\uB97C \uB5A0\uB098\uAE30 \uC804\uC5D0 \uBB34\uC5B8\uAC00\uB97C \uB098\uBB34
    \uC544\uB798 \uC228\uAE30\uB294 \uAC83\uC744 \uBCF4\uC558\uB2E4.\r\n\r\n\uADF8
    \uD3B8\uC9C0\uB97C \uAC00\uC838\uC628 \uB4A4 \uC9C0\uAE08\uAE4C\uC9C0 \uAC04\uC9C1\uD574\uC628
    \uC18C\uC6D4\uC774\uC5C8\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740 \uD3B8\uC9C0\uB97C
    \uD3B4 \uC6C3\uC74C\uAE30 \uAC00\uB4DD\uD55C \uB9D0\uD22C\uB85C \uC77D\uC5B4
    \uB0B4\uB824\uAC14\uB2E4.\r\n\r\n\uC18C\uC6D4\uC5D0\uAC8C \uC790\uC2E0\uC758
    \uB9C8\uC74C\uACFC \uC77C\uC0C1\uC740 \uC774\uBBF8 \uC18C\uC6D4\uB85C \uC774\uB8E8\uC5B4\uC84C\uB2E4\uB294
    \uB0AF\uAC04\uC9C0\uB7EC\uC6B4 \uAE00\uC744 \uC77D\uB358 \uC18C\uC6D4\uC744 \uD5A5\uD574
    \uD558\uB780\uC774 \uADF8\uB9CC \uC77D\uC73C\uB77C\uACE0 \uC18C\uB9AC\uCCE4\uC9C0\uB9CC,
    \uC18C\uC6D4\uC740 \uC774\uBBF8 \uBC31 \uBC88\uB3C4 \uB354 \uC77D\uC5C8\uB2E4\uBA70
    \uD3B8\uC9C0\uC758 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC77D\uC5C8\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uAE00\uC758 \uB0B4\uC6A9\uC5D0 \uB534\uC9C0\uB97C \uAC78\uBA74\uC11C \uC6C3\uC5C8\uACE0,
    \uD3B8\uC9C0\uB97C 10\uC77C \uB3D9\uC548 \uC4F4 \uAC83\uC744 \uC9D1 \uCC3D\uBB38\uC5D0\uC11C
    \uC9C0\uCF1C\uBCF4\uC558\uB2E4\uBA70 \uB180\uB838\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uD3B8\uC9C0\uB97C \uC9C1\uC811 \uBC1B\uC558\uC73C\uBA74 \uC815\uB7B5\uACB0\uD63C\uC744
    \uAE68\uACE0 \uBC1B\uC544\uC8FC\uB824 \uD588\uB2E4\uACE0 \uC7A5\uB09C\uC744 \uACC4\uC18D\uD574\uC11C
    \uCCE4\uB2E4.\r\n\r\n\uC6C3\uB294 \uC18C\uC6D4\uC5D0\uAC8C \uD558\uB780\uC740
    \uC9C4\uC2EC\uC744 \uB2F4\uC544 \uB2E4\uC2DC \uB9C8\uC74C\uC744 \uC804\uD588\uB2E4.\r\n\r\n\uD558\uB780\uC740
    \uC544\uC9C1 \uC18C\uC6D4\uC744 \uC88B\uC544\uD588\uB2E4.\r\n\r\n\uC18C\uC6D4\uC758
    \uC6D0\uB9DD\uC5D0 \uC8C4\uCC45\uAC10\uC774 \uB4E4\uC5B4\uB3C4 \uD558\uB780\uC758
    \uB9C8\uC74C\uC740 \uC0AC\uB77C\uC9C4\uB2E4\uACE0 \uC0AC\uB77C\uC9C8 \uC218 \uC788\uB294
    \uD06C\uAE30\uAC00 \uC544\uB2C8\uC5C8\uB2E4.\r\n\r\n\uC774\uBC88\uC5D0 \uD558\uB780\uC740
    \uB9C8\uC74C\uC744 \uB2E4\uD574, \uC18C\uC6D4\uC5D0\uAC8C \uC804\uD558\uC9C0
    \uBABB\uD588\uB358 \uACE0\uBC31\uC744 \uC774\uC5B4\uC11C \uD588\uB2E4.\r\n\r\n\uC18C\uC6D4\uC740
    \uB2F9\uD669\uD55C \uB9D0\uACFC \uBD89\uAC8C \uC0C1\uAE30\uB41C \uC5BC\uAD74\uB85C
    \uB9D0\uC744 \uC787\uC9C0 \uBABB\uD588\uB2E4.\r\n\r\n\uB458\uC740 \uC870\uC6A9\uD574
    \uBD88\uAF43\uB180\uC774\uB97C \uBC14\uB77C\uBCF4\uC558\uACE0 \uB458\uC740 \uC11C\uB85C\uC5D0
    \uB300\uD574 \uAC19\uC740 \uC0DD\uAC01\uC744 \uD558\uACE0 \uC788\uB294 \uAC83
    \uAC19\uC558\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uC815\uC801\uC744 \uAE68\uACE0
    \uC18C\uC6D4\uC5D0\uAC8C \uC11C\uC11C\uD788 \uC5BC\uAD74\uC744 \uAC00\uAE4C\uC774
    \uBD99\uC600\uB2E4.\r\n\r\n\uD558\uC9C0\uB9CC \uBD80\uB044\uB7EC\uC6C0\uC744
    \uCC38\uC9C0 \uBABB\uD55C \uC18C\uC6D4\uC740 \uD558\uB780\uC744 \uB54C\uB9AC\uACE0
    \uD070 \uC18C\uB9AC\uB85C \uD654\uB97C \uB0B4\uBA70 \uC5BC\uBC84\uBB34\uB9B0
    \uB4A4 \uB3C4\uB9DD\uCCE4\uB2E4.\r\n\r\n\uD558\uB780\uC740 \uC18C\uC6D4\uC758
    \uB4B7\uBAA8\uC2B5\uC744 \uBCF4\uBA74\uC11C \uC774\uC81C\uB294 \uB3C4\uB9DD\uCE58\uC9C0
    \uC54A\uACE0 \uC801\uADF9\uC801\uC73C\uB85C \uC18C\uC6D4\uC5D0\uAC8C \uB2E4\uAC00\uAC00\uACA0\uB2E4\uACE0
    \uBC1B\uC544\uC904 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9AC\uACA0\uB2E4\uACE0 \uB9C8\uC74C\uBA39\uC5C8\uB2E4."
