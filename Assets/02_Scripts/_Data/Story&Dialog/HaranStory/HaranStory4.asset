        effectDuration: 0
        effectPower: 0
      line: "\u201C\uB9F9\uC8FC\uB2D8, \uC774\uB300\uB85C \uAC00\uBA74 \uAE08\uD638\uB2F9\uC774
        \uBB34\uB9BC\uC744 \uC7A5\uC545\uD558\uB294\uAC74 \uC2DC\uAC04\uBB38\uC81C\uC785\uB2C8\uB2E4.
        \uC5B4\uCC0C \uB3C8\uB180\uC74C\uD558\uB294 \uCC9C\uD55C \uC0C1\uD68C\uAC00
        \uBB34\uB9BC\uC744 \uC950\uB77D\uD3B4\uB77D\uD558\uAC8C \uD55C\uB2E8 \uB9D0\uC785\uB2C8\uAE4C?\u201D"
