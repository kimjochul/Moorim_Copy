      line: "\uC5B4\uB290 \uB0A0, \uCCA0\uD608\uB2F9\uC744 \uD544\uB450\uB85C \uBB34\uC778
        \uC138\uB825\uB4E4\uC774 \uD55C \uC790\uB9AC\uC5D0 \uBAA8\uC600\uC2B5\uB2C8\uB2E4.\r\n\uB291\uB300,
        \uACF0, \uD638\uB791\uC774, \uC624\uC18C\uB9AC, \uC124\uD45C, \uB9E4 \uB4F1
