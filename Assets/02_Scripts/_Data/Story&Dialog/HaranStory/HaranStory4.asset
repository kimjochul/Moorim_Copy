        effectPower: 0
      line: "\u201C\uB0B4 \uB9F9\uC8FC\uB2D8\uAED8 \uC544\uB8B0\uC790\uBA74 \uAE08\uD638\uB2F9\uACFC
        \uC11C\uBC29\uC774 \uC190\uC744 \uC7A1\uB294\uB2E4\uB294 \uC18C\uBB38\uC774
        \uB3CC\uACE0\uC788\uC18C\uC774\uB2E4. \uC774\uB294 \uBE44\uB2E8 \uAE08\uD638\uB2F9\uBFD0\uB9CC\uC774
        \uC544\uB2CC \uB2E4\uB978 \uC0C1\uC5C5\uC758 \uC885\uC0AC\uD558\uB294 \uC138\uB825\uB3C4
        \uB9C8\uCC2C\uAC00\uC9C0\uC624.\u201D"
