  m_Script: {fileID: 11500000, guid: 609142ec797450f429543e3dfca29176, type: 3}
  m_Name: HaranStory2
  m_EditorClassIdentifier: Assembly-CSharp::Story
  id: 12
  storyName: "2. \uB4F1\uAC00\uAD50\uD658"
  description: "\uC18C\uC6D4\uC740 \uB298 \uADF8\uB807\uB4EF, \uD558\uB780\uC758
    \uC2EC\uAE30\uB97C \uAC74\uB4DC\uB9B0\uB2E4.\n\n\uADF8\uC758 \uAC00\uBB38\uC740
    \uACFC\uAC70 \uBB34\uB9BC\uC5D0 \uBB38\uC81C\uB97C \uC77C\uC73C\uCF30\uACE0 \uD558\uB780\uC740
    \uCE68\uBB35\uD588\uB2E4.\n\n\uACB0\uACFC\uB85C \uC790\uB9E4\uC640 \uD558\uB780\uC774
    \uC0B4\uC558\uB358 \uAC00\uBB38\uB4E4\uACFC \uADF8 \uB9C8\uC744\uC758 \uC8FC\uBBFC\uB4E4\uC740
    \uBAB0\uB77D\uD558\uAC8C \uB41C \uB4EF\uD558\uB2E4.\n\n\uBA85\uC6D4\uC740 \uD558\uB780\uC740
    \uB354 \uC774\uC0C1 \uC6D0\uB9DD\uD558\uC9C0 \uC54A\uC9C0\uB9CC \uC18C\uC6D4\uC740
    \uC911\uC694\uD55C \uC21C\uAC04\uC5D0 \uCE68\uBB35\uC744 \uD0DD\uD55C \uD558\uB780\uC744
    \uC544\uC9C1 \uC99D\uC624\uD558\uACE0 \uC788\uB2E4.\n\n\uD558\uB780 \uB610\uD55C
    \uADF8\uAC00 \uACFC\uAC70\uC5D0 \uBD88\uC758\uC5D0 \uCE68\uBB35\uD55C \uAC83\uC744
    \uD6C4\uD68C\uD558\uACE0 \uC788\uB2E4.\n\n\uD558\uB780\uC740 \uC790\uC2E0\uC5D0\uAC8C
    \uD5A5\uD588\uB358 \uC6D0\uB9DD\uC758 \uB9D0\uB4E4\uC744 \uC18D\uC5D0 \uB2F4\uACE0
    \uD56D\uC0C1 \uACF1\uC539\uACE0 \uC788\uB2E4.\n\n\uC74C\uC2DD\uC744 \uC624\uB798
    \uBCF4\uAD00\uD560 \uC218 \uC788\uB294 \uBCF4\uAD00\uD568\uC774\uB098 \uC88B\uC740
    \uC7AC\uB8CC\uB97C \uC2F8\uAC8C \uB118\uACA8\uC8FC\uB294 \uAC83\uB4E4\uC740 \uD558\uB780\uC774
    \uC870\uAE08\uC774\uB098\uB9C8 \uADF8\uAC00 \uD53C\uD574\uB97C \uC900 \uC790\uB9E4\uC5D0\uAC8C
    \uC18D\uC8C4\uD558\uB294 \uBC29\uBC95\uC774\uB2E4."
  mainSpeaker: "\uD558\uB780"
  characterIDs: 000000000100000002000000
