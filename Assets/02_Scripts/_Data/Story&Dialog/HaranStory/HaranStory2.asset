      line: "\uACA8\uC6B8 \uB118\uC5B4 \uACE0\uD5A5 \uCC3E\uC544\uC628 \uC0C8\uB294
        \uAC00\uC7A5 \uC624\uB798\uB41C \uB098\uBB34\uC5D0 \uBB38\uC548\uC778\uC0AC
        \uB4DC\uB9AC\uC9C0\uB9CC, \uC124\uD55C\uC744 \uD53C\uD574 \uB3C4\uB9DD\uCE5C
        \uC5EC\uC6B0\uB294 \uBD04\uC774 \uCC3E\uC544\uC628\uC9C0\uB3C4 \uBAA8\uB974\uACE0
