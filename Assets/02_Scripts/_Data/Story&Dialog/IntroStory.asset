        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uBB34\uB9BC\uC740 \uC11C\uBC29\uC778\uC744 \uACBD\uACC4\uD588\uACE0,
        \uC11C\uBC29\uC740 \uBB34\uB9BC\uC778\uC744 \uBBFF\uC9C0 \uC54A\uC558\uB2E4.\r\n\uAE38
        \uC704\uC5D0\uC11C\uB294 \uC5EC\uC804\uD788 \uC11C\uB85C\uC758 \uC2DC\uC120\uC744
        \uD53C\uD588\uACE0 \uC8FC\uB9C9\uC5D0\uC11C\uB294 \uAC19\uC740 \uC790\uB9AC\uC5D0
        \uC549\uB294 \uC77C\uC870\uCC28 \uB4DC\uBB3C\uC5C8\uB2E4."
