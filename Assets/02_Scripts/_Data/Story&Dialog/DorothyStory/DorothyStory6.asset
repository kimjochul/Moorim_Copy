  m_Script: {fileID: 11500000, guid: 609142ec797450f429543e3dfca29176, type: 3}
  m_Name: DorothyStory6
  m_EditorClassIdentifier: Assembly-CSharp::Story
  id: 26
  storyName: "6. \uD568\uAED8\uC600\uB358 \uC2DC\uAC04\uC740"
  description: "\uB9AC\uBB34\uB294 \uC77C\uC5B4\uB098\uC790\uB9C8\uC790 \uC18C\uB9AC\uB97C
    \uC9C0\uB974\uBA70 \uC544\uB974\uCF04\uC744 \uCC3E\uC544\uB2E4\uB154\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC7A0\uACB0\uC5D0 \uADF8\uB9BD\uACE0 \uC2AC\uD508 \uB0C4\uC0C8\uB97C \uB9E1\uC558\uACE0,
    \uC81C\uBC1C \uC544\uB974\uCF04\uC774 \uBCF8\uC778 \uB300\uC2E0 \uACA9\uC804\uC9C0\uB85C
    \uAC04 \uAC83\uC774 \uC544\uB2C8\uAE30\uB97C \uBE4C\uC5C8\uB2E4.\r\n\r\n\uADF8\uB7F0
    579\uBC88\uC744 \uC6B0\uCCB4\uBD80 \uAD00\uB9AC \uAC10\uB3C5\uAD00\uC774 \uBD88\uB7EC\uC138\uC6E0\uB2E4.\r\n\r\n\uB8E8\uBBF8\uB098\uB85C
    \uD5A5\uD558\uB294 \uBC30\uC1A1 \uD3B8\uC9C0\uB4E4\uC774 \uC5B4\uB514 \uC788\uB0D0\uACE0
    \uBB3B\uB294 \uB9AC\uBB34\uC5D0\uAC8C \uAC10\uB3C5\uAD00\uC740 \uC774\uC0C1\uD558\uAC8C
    579\uBC88\uC774 \uC544\uB2C8\uB77C \uB9AC\uBB34\uC758 \uC774\uB984\uC73C\uB85C
    \uBD88\uB800\uB2E4.\r\n\r\n\uAC10\uB3C5\uAD00\uC740 \uBA74\uB2F4\uC5D0\uC11C
    \uB9AC\uBB34\uAC00 \uB9D0\uD55C \uC870\uAC74 \uADF8\uB300\uB85C \uC544\uB974\uCF04\uC774
    \uB9AC\uBB34\uB97C \uB300\uC2E0\uD558\uC5EC \uACA9\uC804\uC9C0\uB85C \uBC30\uC1A1\uD558\uB7EC
    \uAC14\uB2E4\uACE0 \uB9D0\uD588\uB2E4.\r\n\r\n\uADF8\uB807\uAE30 \uB54C\uBB38\uC5D0
    \uC774\uC81C \uB9AC\uBB34\uB294 \uC6B0\uCCB4\uBD80\uAC00 \uC544\uB2CC \uC790\uC720\uB77C\uACE0
    \uC124\uBA85\uD574 \uC92C\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294 \uC544\uB974\uCF04\uC774
    \uC8FD\uC5C8\uC744 \uB9AC \uC5C6\uB2E4\uACE0 \uC548 \uC8FD\uC5C8\uC744 \uD14C\uB2C8
    \uBCF4\uC0C1\uAE08\uC740 \uBC1B\uC744 \uC218 \uC5C6\uB2E4\uACE0 \uBD80\uC815\uD588\uB2E4.\r\n\r\n\uAC10\uB3C5\uAD00\uC740
    \uB8E8\uBBF8\uB098\uC758 \uC0C1\uD669\uC744 \uC124\uBA85\uD574 \uC8FC\uC5C8\uB2E4.\r\n\r\n\uACA9\uC804\uC9C0
    \uB8E8\uBBF8\uB098\uB294 \uD604\uC7AC \uBB34\uB9BC\uC5D0 \uAC70\uC758 \uC810\uB839
    \uB410\uACE0 \uD328\uC794\uBCD1 \uD639\uC740 \uD3EC\uB85C\uB4E4 \uB9D0\uACE0\uB294
    \uC5C6\uC744 \uAC83\uC774\uB77C\uB294 \uB9D0\uC774\uC5C8\uB2E4.\r\n\r\n\uB8E8\uBBF8\uB098\uC5D0
    \uC6B0\uCCB4\uBD80\uB97C \uBCF4\uB0B4\uB294 \uC774\uC720\uB294 \uACBD\uACC4 \uC0C1\uD0DC\uB97C
    \uD655\uC778\uD558\uB294 \uC774\uC720 \uD558\uB098\uC600\uB2E4.\r\n\r\n\uB8E8\uBBF8\uB098\uC5D0
    \uC6B0\uCCB4\uBD80\uB97C \uBCF4\uB0B4\uC11C \uC8FD\uC73C\uBA74 \uC774\uD6C4\uC5D0
    \uB2E4\uB978 \uC6B0\uCCB4\uBD80\uB97C \uBCF4\uB0B4\uACE0 \uC6B0\uCCB4\uBD80\uAC00
    \uC0B4\uC544 \uB3CC\uC544\uC624\uBA74 \uBB34\uB9BC \uBCD1\uB825\uC774 \uBE60\uC84C\uB2E4\uB294
    \uD310\uB2E8\uD558\uC5D0 \uAD70\uB300\uB97C \uBCF4\uB0B4\uB294 \uC791\uC804\uC774\uC5C8\uB2E4.\r\n\r\n\uC774\uC804\uC5D0
    \uC0AC\uB77C\uC9C4 241, 331 \uC804\uBD80 \uCC98\uC74C\uBD80\uD130 \uBC84\uB824\uC9C8
    \uAC83\uC744 \uC54C\uACE0 \uBCF4\uB0B4\uC84C\uB2E4.\r\n\r\n\uBB34\uC5F0\uACE0\uC790\uC778
    \uD2B9\uAE09 \uC6B0\uCCB4\uBD80\uB294 \uAC00\uC7A5 \uC2F8\uAC8C \uBC84\uB9B4
    \uC218 \uC788\uB294 \uC778\uB825\uC774\uC5C8\uB2E4.\r\n\r\n\uAC10\uB3C5\uAD00\uC740
    \uBAA8\uB4E0 \uC6D0\uB9DD\uC744 \uC9CA\uC5B4\uC9C8 \uC0DD\uAC01\uC73C\uB85C \uBB34\uC5F0\uACE0\uC790\uB4E4\uC744
    \uD76C\uC0DD\uC2DC\uD0A4\uC790\uB294 \uC791\uC804\uC744 \uC0C1\uBD80\uC5D0 \uC8FC\uC7A5\uD588\uC5C8\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uAC10\uB3C5\uAD00\uC5D0\uAC8C \uC544\uB974\uCF04\uC774 \uC5B8\uC81C \uCD9C\uBC1C\uD588\uB294\uC9C0
    \uBB3C\uC5C8\uACE0 \uAC10\uB3C5\uAD00\uC740 7\uC2DC\uAC04 \uC815\uB3C4 \uC9C0\uB0AC\uB2E4\uACE0
    \uB2F5\uD588\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294 \uC544\uB974\uCF04\uC774 \uC5C6\uB2E4\uBA74
    \uC790\uC720\uB3C4 \uB3C8\uB3C4 \uD544\uC694 \uC5C6\uB2E4\uACE0 \uB9D0\uD558\uACE0
    \uC544\uB974\uCF04\uC744 \uCC3E\uC544 \uB2EC\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740
    \uBE60\uB978 \uC6B0\uCCB4\uBD80\uC600\uAE30 \uB54C\uBB38\uC5D0 \uBC24\uB0AE\uC5C6\uC774
    \uB2EC\uB838\uB2E4.\r\n\r\n\uAE38\uCE58\uC778 \uB9AC\uBB34\uB294 \uAE38\uC744
    \uC783\uAE30\uB3C4 \uD588\uC9C0\uB9CC \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4.\r\n\r\n\uC2DC\uAC04\uC774
    \uC5BC\uB9C8\uB098 \uC9C0\uB0AC\uB294\uC9C0\uB3C4 \uAE30\uC5B5 \uBABB \uD558\uACE0
    \uC544\uD320\uB2E4\uB294 \uAC83\uB9CC \uAE30\uC5B5\uB098\uC9C0\uB9CC \uC81C\uBC1C
    \uB2A6\uC9C0 \uC54A\uAE30\uB97C \uBC14\uB77C\uBA70 \uB2EC\uB838\uB2E4.\r\n\r\n\uB8E8\uBBF8\uB098\uB294
    \uC870\uC6A9\uD588\uB2E4.\r\n\r\n\uBB34\uB108\uC9C4 \uAC74\uBB3C\uB4E4 \uC5F0\uAE30,
    \uC2DC\uCCB4\uC758 \uD53C \uB0C4\uC0C8, \uB3C4\uC800\uD788 \uD3B8\uC9C0\uAC00
    \uB3C4\uCC29\uD560\uB9CC\uD55C \uC7A5\uC18C\uAC00 \uC544\uB2C8\uC5C8\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC544\uB974\uCF04\uC758 \uC774\uB984\uC744 \uBD80\uB974\uBA70 \uCC3E\uC544\uB2E4\uB154\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC744
    \uCC3E\uB358 \uB9AC\uBB34\uB294 \uD3D0\uD5C8\uAC00 \uB41C \uC9D1\uB4E4 \uC55E\uC5D0
    \uD3B8\uC9C0\uAC00 \uB193\uC5EC \uC788\uB294 \uAC83\uC744 \uBC1C\uACAC\uD588\uB2E4.\r\n\r\n\uD3B8\uC9C0\uB97C
    \uB193\uB294 \uBC29\uC2DD\uC774 \uC544\uB974\uCF04\uC774\uC5C8\uB2E4.\r\n\r\n\uD3B8\uC9C0\uB97C
    \uB530\uB77C\uAC00\uB2C8 \uC810\uC810 \uC775\uC219\uD55C \uB0C4\uC0C8\uC640 \uD53C
    \uB0C4\uC0C8\uAC00 \uAC19\uC774 \uB0AC\uB2E4.\r\n\r\n\uAE34 \uD54F\uC790\uAD6D\uC744
    \uB530\uB77C\uAC00\uB2C8 \uD55C \uB178\uC778\uC774 \uC788\uC5C8\uB2E4.\r\n\r\n\uB178\uC778\uC740
    \uC544\uB974\uCF04\uC774 \uB05D\uAE4C\uC9C0 \uD3EC\uACA9\uC774 \uC9D1\uC744 \uBD80\uC234\uB3C4
    \uCD1D\uC18C\uB9AC\uAC00 \uC0AC\uBC29\uC5D0 \uB4E4\uB824\uB3C4 \uBBF8\uCE5C \uC0AC\uB78C\uCC98\uB7FC
    \uB3CC\uC544\uB2E4\uB2C8\uBA74\uC11C \uD3B8\uC9C0\uB97C \uB193\uC558\uB2E4\uACE0
    \uB9D0\uD588\uB2E4.\r\n\r\n\uB178\uC778\uC740 \uC804\uC7C1 \uC911\uC5D0\uB3C4
    \uBAA9\uC228 \uAC78\uACE0 \uD3B8\uC9C0\uB97C \uBC30\uB2EC\uD558\uB294 \uC544\uB974\uCF04\uC744
    \uBCF4\uACE0 \uC544\uC9C1 \uC138\uC0C1\uC5D0 \uD76C\uB9DD\uC774 \uC788\uB2E4\uB294
    \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4.\r\n\r\n\uB178\uC778\uC740 \uB9AC\uBB34\uC5D0\uAC8C
    \uC544\uB974\uCF04\uC758 \uC704\uCE58\uB97C \uB9D0\uD574\uC8FC\uC5C8\uACE0 \uD54F\uC790\uAD6D\uC744
    \uB530\uB77C \uB9AC\uBB34\uB294 \uC544\uB974\uCF04\uC744 \uCC3E\uC544\uAC14\uB2E4.\r\n\r\n\uD54F\uC790\uAD6D\uC744
    \uB530\uB77C\uAC08\uC218\uB85D \uC544\uB974\uCF04\uC758 \uB0C4\uC0C8\uAC00 \uAC00\uAE4C\uC6CC\uC84C\uC9C0\uB9CC
    \uD53C \uB0C4\uC0C8\uB3C4 \uC9D9\uC5B4\uC84C\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC758
    \uB0C4\uC0C8\uAC00 \uAC00\uAE4C\uC6CC\uC9C4 \uC21C\uAC04 \uC544\uB974\uCF04\uC758
    \uBAA8\uC790\uB97C \uBC1C\uACAC\uD558\uACE0 \uC544\uB974\uCF04\uC758 \uC774\uB984\uC744
    \uBD88\uB800\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uC790\uC2E0\uC744 \uCC3E\uC544
    \uC804\uC7C1\uD130\uC5D0 \uC628 \uB9AC\uBB34\uC5D0 \uC65C \uC654\uB0D0\uACE0
    \uAC71\uC815\uD588\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294 \uAC19\uC774 \uC5EC\uD589
    \uAC00\uAE30\uB85C \uD55C \uC57D\uC18D\uD588\uB2E4\uACE0 \uC77C\uC5B4\uB098\uB77C\uACE0
    \uBE4C\uC5C8\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uC57D\uC18D\uC740 \uBBF8\uB904\uC57C\uACA0\uB2E4\uACE0
    \uD798\uACB9\uAC8C \uB9D0\uC744 \uC774\uC5C8\uB2E4.\r\n\r\n\uBB34\uB108\uC9C4
    \uAC74\uBB3C \uC794\uD574\uB294 \uC544\uB974\uCF04\uC758 \uBAB8\uC744 \uB36E\uC5C8\uACE0
    \uC2EC\uAC01\uD560 \uC815\uB3C4\uB85C \uD53C\uB0C4\uC0C8\uAC00 \uC9C4\uB3D9\uD588\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC544\uB974\uCF04\uC774 \uC65C \uBC14\uBCF4\uAC19\uC774 \uB3C4\uB9DD\uCE58\uC9C0
    \uC54A\uC558\uB0D0\uACE0 \uBB3C\uC5C8\uC9C0\uB9CC, \uC544\uB974\uCF04\uC740 \uC9D1\uC548\uC5D0
    \uC544\uC774\uC640 \uC0AC\uB78C\uB4E4\uC744 \uB370\uB9AC\uACE0 \uB098\uC624\uB290\uB77C
    \uB3C4\uB9DD\uC744 \uBABB \uCCE4\uB2E4\uACE0 \uB2F5\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740
    \uADF8\uB798\uB3C4 \uC544\uC774\uB294 \uB3C4\uB9DD\uCCE4\uB2E4\uACE0 \uC548\uB3C4\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740
    \uB9AC\uBB34\uAC00 \uC6B8\uC0C1\uC774\uB77C\uBA74\uC11C \uC624\uD788\uB824 \uC7A5\uB09C\uC744
    \uCCE4\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294 \uC544\uB974\uCF04\uC774 \uB108\uBB34
    \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC744 \uC704\uD55C\uB2E4\uACE0, \uC190\uD574\uB9CC
    \uBCF4\uB0D0\uACE0 \uB9D0\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uC190\uD574\uB97C
    \uAE30\uAEBC\uC774 \uBD10\uC8FC\uB294 \uBC14\uBCF4\uB4E4 \uB355\uC5D0 \uC138\uC0C1\uC774
    \uB3CC\uC544\uAC04\uB2E4\uACE0 \uB2F5\uD588\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC9C0\uAE08\uAE4C\uC9C0 \uAC10\uB3C5\uAD00\uC5D0\uAC8C \uB9AC\uBB34\uB97C \uAD34\uB86D\uD788\uB294
    \uC0AC\uB78C\uB4E4 \uC804\uBD80 \uAF30\uC9C8\uB800\uB2E4\uACE0, \uC544\uB974\uCF04\uC774
    \uD55C \uBC88 \uB354 \uB3CC\uC544\uBD10 \uC904\uAE4C \uBD10 \uC5F0\uAE30\uD55C
    \uAC70\uB77C\uACE0 \uC544\uB974\uCF04\uC740 \uBA4D\uCCAD\uC774\uB77C\uACE0 \uC6B8\uBA74\uC11C
    \uB9D0\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uC790\uC2E0\uC740 \uBC14\uBCF4\uC5EC\uC11C
    \uC6B0\uCCB4\uBD80\uC5D0\uB3C4 \uC790\uC6D0\uD588\uB2E4\uACE0 \uB2F5\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740
    \uB9AC\uBB34\uC5D0\uAC8C, \uC5B4\uB5A4 \uC0AC\uB78C\uB4E4\uC740 \uC885\uC774
    \uCABC\uAC00\uB9AC\uC778 \uD3B8\uC9C0 \uB355\uBD84\uC5D0 \uD76C\uB9DD\uC744 \uAC00\uC9C0\uACE0
    \uB0B4\uC77C\uC744 \uC0B4\uC544\uAC04\uB2E4\uACE0, \uC790\uC2E0\uC740 \uC628
    \uC138\uACC4\uB97C \uB5A0\uB3CC\uBA74\uC11C \uD76C\uB9DD\uC758 \uC774\uC57C\uAE30\uB97C
    \uC804\uD558\uB294 \uC0AC\uB78C\uC774 \uB418\uACE0 \uC2F6\uC5C8\uB2E4\uACE0 \uB9D0\uD588\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC57D\uC721\uAC15\uC2DD\uC758 \uC138\uC0C1\uC5D0 \uC544\uB974\uCF04 \uAC19\uC740
    \uCC29\uD55C \uC0AC\uB78C\uC740 \uC8FD\uACE0 \uC804\uC7C1\uC744 \uC77C\uC73C\uD0A8
    \uB188\uB4E4\uC740 \uC798 \uBA39\uACE0 \uC798\uC0B0\uB2E4\uACE0 \uD76C\uB9DD\uC740
    \uC5C6\uB2E4\uACE0 \uD654\uB97C \uB0C8\uB2E4.\r\n\r\n\uB610\uD55C \uB9AC\uBB34\uB294
    \uC6B8\uBA74\uC11C \uC65C \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uD558\uB294 \uAC70\uB0D0\uACE0
    \uC544\uB974\uCF04\uC5D0\uAC8C \uD638\uC18C\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740
    \uB9C8\uC9C0\uB9C9\uC744 \uC9C1\uAC10\uD558\uACE0 \uC228\uC744 \uD06C\uAC8C \uBAB0\uC544\uC26C\uC5C8\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC810\uC810 \uC544\uB974\uCF04\uC758 \uB0C4\uC0C8\uAC00 \uC5C6\uC5B4\uC9C0\uACE0
    \uC2DC\uCCB4\uC758 \uB0C4\uC0C8\uAC00 \uB098\uACE0 \uC788\uB294 \uAC83\uC744
    \uB290\uAF08\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294 \uC790\uC2E0\uC758 \uCF54\uC744
    \uB72F\uC5B4\uBC84\uB9AC\uACE0 \uC2F6\uC5C8\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740
    \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB9AC\uBB34\uC5D0\uAC8C \uB9D0\uC744 \uC804\uD558\uAE30
    \uC2DC\uC791\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uB9AC\uBB34\uAC00
    \uC0AC\uB78C \uB3D5\uB294\uB2E4\uACE0 \uC190\uD574 \uBCF4\uACE0, \uC704\uD5D8\uD55C
    \uACF3\uC5D0 \uB6F0\uC5B4\uB4E4\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uB2E4\uACE0
    \uADF8\uB7F0 \uC0AC\uB78C\uC740 \uC790\uC2E0 \uD558\uB098\uBA74 \uCDA9\uBD84\uD558\uB2E4\uACE0,
    \uC194\uC9C1\uD788 \uB9AC\uBB34\uAC00 \uC804\uC7C1\uD130\uAE4C\uC9C0 \uC790\uC2E0\uC744
    \uCC3E\uC544\uC640 \uC8FC\uC5B4\uC11C \uB9C8\uC9C0\uB9C9\uC774 \uC4F8\uC4F8\uD558\uC9C0
    \uC54A\uC544\uC11C \uB108\uBB34 \uC88B\uC558\uB2E4\uACE0 \uB9D0\uD588\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uB108\uBB34 \uB2A6\uC5B4\uC11C \uBBF8\uC548\uD558\uB2E4\uACE0 \uAE54\uB824 \uC8FD\uB294
    \uAC83\uC740 \uC6D0\uB798 \uC790\uC2E0\uC774\uC5C8\uC5B4\uC57C \uD55C\uB2E4\uACE0
    \uC6B8\uBA74\uC11C \uB9D0\uD588\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uB9AC\uBB34\uAC00
    \uC5ED\uC2DC \uC88B\uC740, \uB530\uB73B\uD55C \uC0AC\uB78C\uC774\uB77C\uACE0
    \uB9D0\uD574\uC8FC\uC5C8\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
    \uD558\uB298\uC744 \uBCF4\uC558\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC774 \uBCF8
    \uB9C8\uC9C0\uB9C9 \uD558\uB298\uC740 \uCC38 \uB9D1\uC558\uB2E4.\r\n\r\n\uB9AC\uBB34\uB294
    \uC77C\uC5B4\uB098\uB77C\uACE0, \uD63C\uC790 \uC5EC\uD589 \uAC08 \uC218\uB294
    \uC5C6\uB2E4\uACE0 \uAC19\uC774 \uAC00\uC918\uC57C \uD55C\uB2E4\uACE0, \uC7A5\uB09C\uC774\uB77C\uACE0
    \uC77C\uC5B4\uB098\uC11C \uB9D0\uD574\uB2EC\uB77C\uACE0 \uC6B8\uBA74\uC11C \uC544\uB974\uCF04\uC744
    \uD754\uB4E4\uC5C8\uB2E4.\r\n\r\n\uC544\uB974\uCF04\uC740 \uC6C0\uC9C1\uC774\uC9C0
    \uC54A\uC558\uB2E4."
