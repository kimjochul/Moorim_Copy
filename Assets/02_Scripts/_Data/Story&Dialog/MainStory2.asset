  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 609142ec797450f429543e3dfca29176, type: 3}
  m_Name: MainStory2
  m_EditorClassIdentifier: Assembly-CSharp::Story
  id: 2
  storyName: "\uAC10\uAC10\uBB34\uC18C\uC2DD"
  scenes:
  - characters:
    - characterID: 0
      slotIndex: 0
      startVisible: 1
    - characterID: 1
      slotIndex: 1
      startVisible: 1
    - characterID: 2
      slotIndex: 2
      startVisible: 0
    lines:
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uAC00\uAC8C \uBB38\uC744 \uC5F0\uC9C0\uB3C4 \uC5B4\uC5F0 1\uB2EC. \uC7A5\uC0AC\uAC00
        \uC0DD\uAC01\uBCF4\uB2E4 \uC218\uC6D4\uD558\uAC8C \uC9C4\uD589\uB418\uC9C0
        \uC54A\uC544 \uBA85\uC6D4\uC740 \uD0C1\uC790\uC5D0 \uC549\uC544 \uACE0\uC2EC\uD55C\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uC624\uB77C\uB294 \uC190\uB2D8\uC740 \uC548\uC624\uACE0 \uD30C\uB9AC\uB9CC
        \uB208 \uC55E\uC5D0\uC11C \uC54C\uC9F1\uAC70\uB9AC\uC790 \uBA85\uC6D4\uC740
        \uBD84\uB178\uD558\uC5EC \uC560 \uBA3C \uD30C\uB9AC\uB97C \uC7A1\uB2E4\uAC00
        \uB118\uC5B4\uC838\uC11C \uC758\uC790 \uD558\uB098\uB97C \uBD80\uC234\uBC84\uB9AC\uACE0, 
        \uC8FC\uBC29\uC5D0 \uC788\uB358 \uC18C\uC6D4\uC740 \uC18C\uB9AC\uC5D0 \uB180\uB77C
        \uB6F0\uCCD0\uB098\uC624\uC9C0\uB9CC \uD55C\uC2EC\uD558\uB2E4\uB294 \uB4EF
        \uBA85\uC6D4\uC744 \uCCD0\uB2E4\uBCF4\uBA70 \uD55C\uB9C8\uB514 \uD55C\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uC798 \uB410\uB124, \uB9C8\uCE68 \uB554\uAC10 \uB0BC \uB3C8\uB3C4
        \uC5C6\uC5B4\uC11C \uB098\uBB34\uAC00 \uD544\uC694\uD558\uAE34 \uD588\uC5B4.\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uC18C\uC6D4, \uC6B0\uB9AC \uC774\uC81C \uC5B4\uB5A1\uD558\uC9C0?\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uC18C\uC6D4\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uB354 \uCCA0\uC5C6\uB294
        \uC5B8\uB2C8\uC758 \uB9D0\uC5D0 \uB208\uC744 \uC9C8\uB048 \uAC10\uC73C\uBA70
        \uD314 \uC18C\uB9E4\uB97C \uAC10\uC544\uC950\uC5C8\uB2E4."
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uB098\uB3C4 \uC798 \uBAB0\uB77C.\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uADF8\uB7F0 \uB9D0 \uB9D0\uACE0.. \uC774\uBBF8 \uC77C\uC740 \uBC8C\uC5B4\uC84C\uC796\uC544..\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uC77C\uC744 \uB0B4\uAC00 \uBC8C\uB838\uC5B4? \uBC8C\uB9B0 \uC0AC\uB78C\uC774
        \uC54C\uC544\uC11C \uC218\uC2B5\uD574\uC57C\uC9C0.\u201D"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uADF8\uAC83\uB3C4 \uB9DE\uC9C0\uB9CC\u2026\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uD558\uB8E8\uC5D0 \uC190\uB2D8\uC774 \uD55C\uBA85\uC774\uB77C\uB3C4
        \uC624\uBA74 \uAC10\uC0AC\uD560 \uC815\uB3C4\uB85C, \uC2E0\uC7A5\uAC1C\uC5C5\uC774\uB77C
        \uADF8\uB7F0\uC9C4 \uBAB0\uB77C\uB3C4 \uC774 \uC0B0\uACE8\uC9DC\uAE30\uC5D0
        \uC0AC\uB78C\uB4E4\uC774 \uB4DC\uB098\uB4E4\uC77C\uC740 \uB9CE\uC9C0 \uC54A\uC558\uB2E4.\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uBA85\uC6D4\uB610\uD55C 10\uC77C\uC815\uB3C4 \uC9C0\uB0AC\uC744\uB54C\uC5D4
        \uCC98\uC74C\uCC98\uB7FC \uB099\uAD00\uC801\uC778 \uAE30\uC138\uC600\uC9C0\uB9CC,
        \n\uADF8\uB7EC\uACE0\uC11C \uD558\uB8E8..\uC774\uD2C0..\n\uACC4\uC18D\uB418\uB294
        \uBB34\uC18C\uC2DD \uC704\uB85C \uBD88\uC548\uD568\uACFC \uC9C0\uB8E8\uD568\uB9CC\uC774
        \uB0A1\uC740 \uD0C1\uC790 \uC704\uB85C \uC313\uC5EC\uB9CC\uAC14\uB2E4. \uC774\uC73D\uACE0
        \uB9D0\uBB38\uC744 \uB5C0\uAC74 \uBA38\uB9AC\uC18D\uC5D0\uC11C \uACC4\uC0B0\uC744
        \uB9C8\uCE5C \uC18C\uC6D4\uC774\uC600\uB2E4.\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uBE4C\uB9B0 \uB3C8 \uC774\uC790\uB294?\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uC18C\uC6D4\uC774 \uBB3B\uC790 \uBA85\uC6D4\uC740 \uC6C0\uCC14\uAC70\uB9AC\uBA70
        \uB300\uB2F5\uD588\uB2E4.\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uBE44.\uBE4C\uB838\uB2E4\uB2C8? \uB0B4\uAC00 \uBB34\uC2A8 \uB3C8\uC744
        \uBE4C\uB824? \uB18D\uB2F4\uB3C4 \uCC38.\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uBE68\uB9AC, \uB3C8 \uC5BC\uB9C8\uB098 \uBE4C\uB838\uB294\uC9C0
        \uC548 \uBB3C\uC5B4\uBCFC\uD14C\uB2C8\uAE4C \uB204\uAD6C\uD55C\uD14C \uBE4C\uB838\uB294\uC9C0\uB098
        \uB9D0\uD574.\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uADF8..\uADF8\uAC74\u2026\uC880 \uACE4\uB780\uD55C\uB370..\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uC81C 2\uD45C\uAD6D? \uC544\uB2D8 \uB300\uBD80\uC5C5? \uD654\uB0B4\uAE30
        \uC804\uC5D0 \uBE68\uB9AC \uB9D0\uD574.\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uC544.\uC548\uB3FC! \uC9C4\uC9DC \uB9D0\uD558\uC9C0 \uB9D0\uB7AC\uC5B4,
        \uCC28\uB77C\uB9AC \uB0A0 \uC8FD\uC5EC! \uBC30\uC9F8!\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 1
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 1
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\u201C\uD558\uC544..\uBA38\uB9AC\uC544\uD30C..\u201D\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 1
      characterID: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      line: "\uB300\uC790\uB85C \uB204\uC6CC\uBC84\uB9B0 \uBA85\uC6D4, \uBA38\uB9AC\uC544\uD508
        \uB4EF \uC190\uC73C\uB85C \uBA38\uB9AC\uB97C \uC9DA\uB294 \uC18C\uC6D4 \uC0AC\uC774\uB85C,
        \uB204\uAD70\uAC00\uAC00 \uAC1D\uC794\uC5D0 \uBC1C\uC744 \uB4E4\uC600\uB2E4.\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 0
    - id: 0
      lineType: 0
      characterID: 2
      emotion: 0
      motion:
        type: 8
        duration: 3
        value: 1500
      line: "...\t"
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      isUnknown: 1
    background: {fileID: 21300000, guid: fc62914ec8888a444af1809bd1ef9d0e, type: 3}
