      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uD5C8\uB098 \uAC80\uC9D1\uC5D0 \uC788\uB294 \uAC80\uC740 \uC81C \uC4F8\uBAA8\uB97C
        \uB2E4\uD558\uC9C0 \uBABB\uD55C\uB2E4\uACE0 \uD588\uC5C8\uB098\uC694.\r\n\uD3C9\uD654\uC758
        \uC2DC\uB300\uAC00 \uB3C4\uB798\uD568\uC5D0 \uB530\uB77C \uBB34\uB97C \uB2F4\uB2F9\uD558\uB294
        \uB2F9\uB4E4\uC740 \uAC00\uBA74 \uAC08\uC218\uB85D \uC704\uCD95\uB418\uC5B4\uAC14\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 21
      isUnknown: 0
      emotion: 0
