        value: 0
        targetSlotIndex: 0
        stopDistance: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uC791\uC740 \uC0C1\uB2E8\uBD80\uD130 \uD070 \uC0C1\uB2E8\uAE4C\uC9C0
        \uAD00\uB9AC\uD558\uACE0 \uB3C8\uC758 \uC720\uD1B5\uC744 \uCC45\uC784\uC9C0\uB294
        \uC5EC\uC6B0\uC871\uC758 \uAE08\uD638\uB2F9.\r\n\uBAA8\uB4E0 \uAC1D\uC794\uC744
        \uAC80\uC5F4\uD558\uACE0 \uD544\uC694\uD558\uB2E4\uBA74 \uC74C\uC2DD\uC758
        \uBE44\uBC95\uAE4C\uC9C0 \uC54C\uB824\uC8FC\uB294 \uD310\uB2E4\uC871\uC758
        \uC6C5\uBB18\uB2F9."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
