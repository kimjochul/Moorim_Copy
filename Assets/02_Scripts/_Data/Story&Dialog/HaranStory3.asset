      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uC804\uC7C1\uC774 \uC77C\uC5B4\uB098\uAE30 \uC804 \uBB34\uB9BC\uC758
        \uC2EC\uC7A5\uC5D4 \uBB34\uB9BC\uB9F9\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB9AC\uACE0
        \uADF8 \uC8FC\uBCC0\uC5D4 \uAC15\uB825\uD55C 10\uB300 \uB2F9\uC774 \uC704\uCE58\uD558\uACE0
        \uC788\uC5C8\uC9C0\uC694."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
