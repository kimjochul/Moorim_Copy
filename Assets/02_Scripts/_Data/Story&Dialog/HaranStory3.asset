      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uBB34\uAC00\uB188\uB4E4\uC740 \uC798 \uC0AC\uB294 \uC0AC\uB78C\uB4E4
        \uB3C8 \uAC77\uB294 \uC774\uC720\uAC00 \uBB50\uB0D0! \uC774\uC81C \uC804\uC7C1\uB3C4
        \uC548\uD558\uB294\uB370 \uBCF4\uD638\uC138\uB97C \uB300\uCCB4 \uC65C \uAC77\uB294\uAC70\uC57C?"
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 22
      isUnknown: 0
      emotion: 0
      motion:
