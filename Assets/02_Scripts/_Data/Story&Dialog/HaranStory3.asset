        effectPower: 0
      line: "\uADF8\uB4E4\uC758 \uB9D0\uB9C8\uB530\uB098 \uC804\uB780\uC758 \uC2DC\uB300\uB294
        \uC800\uBB3C\uACE0 \uCE7C\uC744 \uB9CC\uB4E4\uB358 \uC2DC\uB300\uB294 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\r\n\uBD84\uD30C\uAC04
        \uC804\uC7C1 \uB610\uD55C \uC804\uC804\uB300\uC758 \uBB34\uB9BC\uB9F9\uC8FC\uAC00
        \uBAA8\uB4E0 \uB2F9\uB4E4\uC744 \uBB34\uB9BC\uB9F9 \uADFC\uCC98\uC5D0 \uB450\uBA74\uC11C
        \uD1B5\uD569\uC2DC\uCF30\uAE30\uC5D0 \uB2F9 \uAC04 \uB9C8\uCC30\uB3C4 \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
