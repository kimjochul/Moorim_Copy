        value: 0
        targetSlotIndex: 0
        stopDistance: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uC815\uBCF4\uB97C \uC0AC\uACE0\uD30C\uB294 \uC950\uC871\uC758 \uC554\uC790\uB2F9\uACFC
        \uB3C5\uACFC \uCE58\uB8CC\uB97C \uB2F4\uB2F9\uD558\uB294 \uBC40\uC871\uB4E4\uC758
        \uC0AC\uD654\uB2F9. \uB9C8\uC74C\uC744 \uCE58\uC720\uD558\uB294 \uC885\uAD50\uB2F9\uC778
        \uD559\uB4E4\uC758 \uC5F0\uD654\uB2F9."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
        targetSlotIndex: 0
        stopDistance: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uBB34\uC778\uC138\uB825\uC778 \uD638\uB791\uC774\uC758 \uB2F9\uC778
        \uCCA0\uD608\uB2F9\uACFC \uAC80\uC744 \uB2E8\uC870\uD558\uB294 \uC624\uC18C\uB9AC\uC7A5\uC778\uB4E4\uC758
        \uB2F9\uC778 \uD654\uB828\uB2F9 \uB4F1\uB4F1.\r\n\uADF8\uC57C\uB9D0\uB85C
        \uC0DD\uC5C5\uACFC \uC0C1\uC5C5\uC744 \uCC45\uC784\uC9C0\uB294 \uB2F9\uB4E4\uACFC
        \uCE58\uC548\uACFC \uC804\uC7C1\uC744 \uB2F4\uB2F9\uD558\uB294 \uB2F9\uB4E4\uC774
        \uD798\uC758 \uADE0\uD615\uC744 \uB9DE\uCD94\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
      resetIllustration: 0
      resetOverlay: 0
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
