      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uD558\uC5EC\uAC04\u2026 \uC774\uAC70 \uC8FC\uBA39 \uBB34\uC11C\uC6CC\uC11C
        \uC5B4\uB514 \uD558\uC18C\uC5F0\uC774\uB098 \uD558\uACA0\uC5B4\uC694?\r\n\uB9DE\uB294
        \uB9D0\uC744 \uD558\uBA74 \uB300\uB738 \uCE7C\uBD80\uD130 \uAEBC\uB0B4\uB2C8
        \uD798\uC5C6\uB294 \uC0AC\uB78C\uB4E4\uC740 \uB9D0\uB3C4 \uBABB\uAEBC\uB0B4\uC9C0."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationOverlay: {fileID: 0}
