      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uC0AC\uB78C\uB4E4\uC740 \uC785\uC744 \uBAA8\uC544 \uCE6D\uC1A1\uD588\uC2B5\uB2C8\uB2E4.\r\n\u201C\uC5C6\uB294\uC790\uB4E4\uC5D0\uAC8C
        \uC785\uC744 \uC637\uACFC \uBA39\uC744\uAC83\uC744 \uC774\uB9AC\uB3C4 \uD638\uCF8C\uD788
        \uB098\uB220\uC8FC\uB2E4\uB2C8. \uC9C4\uC815\uD55C \uD611\uAC1D\uC774\uB2E4.\u201D\r\n\u201C\uAC70\uC9C0\uB4E4\uC5D0\uAC8C
        \uC791\uC740 \uC18C\uC77C\uAC70\uB9AC\uB97C \uB098\uB220\uC8FC\uACE0 \uC0AF\uC744
        \uC8FC\uB2C8 \uCC38\uC73C\uB85C \uAD70\uC790\uB85C\uB2E4.\u201D\r\n\uAE08\uD638\uB2F9\uC758
        \uAE08\uD654\uB4E4\uC740 \uC804 \uBB34\uB9BC\uC5D0 \uD37C\uC838 \uC138\uC0C1
        \uC0AC\uB78C\uB4E4\uC744 \uC774\uB86D\uAC8C \uD588\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      useSmallFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
