      line: "\uADF8\uB9AC\uACE0 \uADF8 \uC0AC\uC774\uC5D0\uC11C \uB3CB\uBCF4\uC600\uB358
        \uC138\uAC00\uB294 \uB2E8\uC5F0 \uAE08\uD638\uB2F9\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uB2F9\uC2DC
        \uB2F9\uC8FC\uB294 \uB098\uB214\uC758 \uBBF8\uD559\uC744 \uC54C\uC558\uAE30\uC5D0,
        \uAE08\uD654\uB97C \uBAA8\uC544\uB3C4 \uD5A5\uB77D\uC5D0 \uB0AD\uBE44\uD558\uC9C0
        \uC54A\uACE0 \uB9CC\uBBFC\uC744 \uC0B4\uD3C8\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
