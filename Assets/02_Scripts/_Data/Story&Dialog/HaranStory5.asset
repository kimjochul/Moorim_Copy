      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uB09C \uC5BB\uC5B4\uB9DE\uAE30 \uC2EB\uC73C\uB2C8\uAE4C \uB2F4\uC5D4
        \uB2C8 \uD63C\uC790 \uD574\uB77C. \uC544\uD30C \uC8FD\uACA0\uB124\u2026"
