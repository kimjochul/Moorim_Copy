      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uADF8\uB550 5\uAC1C \uD6D4\uCCE4\uB294\uB370\uB3C4 \uD558\uB098\uB9CC
        \uD63C\uB0AC\uC73C\uB2C8\uAE4C.\n\uD558\uB098\uB9CC \uD6D4\uCE58\uBA74 \uB2F9\uC5F0\uD788
