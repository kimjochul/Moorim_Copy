        effectPower: 30
      line: "\uADF8\uB798\uB3C4. \uBB58 \uBA39\uC744\uB550 \uB2F9\uC8FC\uB2D8\uC5D0\uAC8C
        \uBB3C\uC5B4\uBCF4\uACE0 \uBA39\uB294 \uD3B8\uC774 \uB0AB\uC9C0 \uC54A\uB098?
