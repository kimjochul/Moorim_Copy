      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uC5B4\uB290 \uC138\uC6D4\uC5D0 \uAF2D\uB300\uAE30\uAE4C\uC9C0 \uAC00\uC11C
