      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uBB50? \uC804\uC5D0 \uC0AC\uACFC\uBC2D \uC11C\uB9AC\uD558\uB294\uAC70
        \uB3C4\uC640\uC92C\uC796\uC544!\r\n\uC804\uC5D0 \uB9CC\uB450 \uD558\uB098
        \uD6D4\uCCE4\uC744\uB54C \uAC19\uC774 \uB098\uB220\uBA39\uC5C8\uC73C\uBA74\uC11C!"
