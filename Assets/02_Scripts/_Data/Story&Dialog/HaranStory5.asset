      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uB2E4\uC74C\uC5D4 \uC5B8\uB2C8\uAE4C\uC9C0 \uB07C\uC5B4\uC11C \uBE68\uB9AC
        \uD6D4\uCE58\uBA74 \uB3FC.\n\uB108 \uC704\uC5D0 \uC5B8\uB2C8 \uC62C\uB9AC\uACE0
        \uB0B4\uAC00 \uC62C\uB77C\uAC00\uBA74 \uD0C1\uC790 \uB192\uC774\uC5D0 \uB531
