      line: "\uAD1C\uCC2E\uC544. \uD560\uBA38\uB2C8\uAC00 \uB9CC\uB450\uB97C \uC5BC\uB9C8\uB098
        \uB9CE\uC774 \uB9CC\uB4E4\uC5C8\uB294\uB370 \uD558\uB098 \uBA39\uB294\uB2E4\uACE0
