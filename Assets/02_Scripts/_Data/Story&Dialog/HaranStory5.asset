      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uC2DC\uC7A5\uB9CC\uB450\uB294 \uD560\uBA38\uB2C8\uAC00 \uB9CC\uB4E0
        \uB9DB\uC774 \uC548\uB098\uAC70\uB4E0?\n\uADF8\uB9AC\uACE0 \uACB0\uAD6D \uD558\uB098
