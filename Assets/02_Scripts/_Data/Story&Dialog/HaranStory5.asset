        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0.3
        effectPower: 30
      line: "\uBA85\uC6D4 \uB204\uC57C\uAC00 \uD37D\uB3C4 \uD611\uC870\uC801\uC73C\uB85C
        \uB098\uC624\uACA0\uB2E4.\n\uB204\uC57C\uAC00 \uD5C8\uC220\uD574\uBCF4\uC5EC\uB3C4
        \uB2C8\uCC98\uB7FC \uB3C4\uB451\uC9C8\uC740 \uC548\uD558\uB294\uAC70 \uBAA8\uB974\uB098."
