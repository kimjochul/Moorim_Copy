      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uB098\uB97C \uC774\uB8E8\uB358 \uBAA8\uB4E0\uAC83\uB4E4\uC740 \uC774\uB0B4
        \uC870\uC6A9\uD574\uC9C0\uACE0 \uCE68\uBB35\uB9CC\uC774 \uC874\uC7AC\uD588\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 0
        effectPower: 0
      line: "\uCD94\uC5B5\uC774 \uAC00\uB4DD\uD588\uB358 \uC7A5\uC18C\uB294 \uBBF8\uB828\uC774
        \uB418\uC5C8\uACE0 \uCD94\uC5B5\uC740 \uC0C1\uD754\uCC98\uB7FC \uB0A0 \uCAD2\uC544\uB2E4\uB154\uC73C\uB2C8,
        \uADF8\uB300\uC758 \uBE48 \uC790\uB9AC\uB97C \uCC44\uC6B0\uB824 \uB2E4\uBD84\uD788
        \uB178\uB825\uD588\uC2B5\uB2C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 13
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 2
        effectDuration: 1.5
        effectPower: 0
      line: "\uB9C9\uB0B4. \uC5EC\uAE34 \uBB34\uC2A8 \uC77C\uC774\uACE0?"
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 2
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC5EC\uAE30 \uBB50 \uD560\uC77C \uC5C6\uB098."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 13
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uD3C9\uC18C\uC5D4 \uCC45\uB9CC \uBCF4\uB294 \uB2C8\uAC00 \uBB34\uC2A8
        \uC77C\uB85C..?\r\n\uC544\uBC84\uC9C0\uAC00 \uB2C8\uD55C\uD14C \uC815\uC2E0
        \uC880 \uCC28\uB9AC\uB77C\uCE74\uB4E0?"
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 2
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uADF8\uB7F0\uAC70 \uC544\uC774\uB2E4. \uADF8\uB0E5\u2026"
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 2
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC774\uC81C \uC77C \uC880 \uD574\uBCF4\uACE0 \uC2F6\uC5B4\uC11C. \uADF8\uB798
        \uB410\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 13
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC774\uC57C..\uCC45\uC744 \uADF8\uB9AC \uC77D\uB354\uB2C8 \uC0AC\uB78C
        \uB410\uB124!\r\n\uC54C\uACA0\uB2E4! \uC774 \uC7A5\uBD80 \uC880 \uCC98\uB9AC\uD574\uB3C4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC14B\uC9F8 \uD615\uC5D0\uAC8C \uCC3E\uC544\uAC00 \uC77C\uAC10\uC744
        \uBC1B\uC544\uC654\uB2E4.\r\n\uD55C\uC7A5..\uB450\uC7A5\u2026\uCC98\uC74C\uC5D4
        \uAC04\uB2E8\uD55C \uC7A5\uBD80 \uD55C\uC7A5 \uC77D\uB294\uAC70\uC5D0\uB3C4
        \uAC70\uC9C4 \uD558\uB8E8\uAC00 \uC9C0\uB098\uAC14\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC544\uBB34\uB834 \uCC45\uC744 \uB9CE\uC774 \uC77D\uC5B4\uB3C4 \uC2E4\uBB34\uB294
        \uC544\uC608 \uB2E4\uB978 \uC138\uACC4\uC600\uB2E4.\r\n\uC0AC\uB78C\uC744
        \uC4F0\uACE0 \uBD80\uB9AC\uB294 \uC77C\uC740 \uCC45\uC5D0 \uC801\uD78C\uAC83\uACFC
        \uB2EC\uB790\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC5B4\uB290 \uB0A0\uC740 \uCC3D\uACE0\uC5D0 \uAC00\uC11C \uC625\uAD6C\uC2AC\uC758
        \uC7AC\uACE0\uB97C \uD558\uB098\uD558\uB098 \uD30C\uC545\uD558\uB294\uAC83\uC5D0
        \uB208\uC774 \uBE60\uC9C0\uB294 \uC904 \uC54C\uC558\uACE0,\r\n\uB3C8\uC744
        \uAC00\uC9C0\uACE0 \uD280\uB294 \uB188\uC774 \uC788\uC5B4 \uADF8\uB188 \uC7A1\uC544\uC624\uB294\uB370\uB3C4
        \uC9C4\uB540\uC744 \uBE90\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 21300000, guid: bb0e3852966702c4aa4bdc08e4645821, type: 3}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uADF8\uB798\uB3C4 \uC88B\uC558\uB2E4. \uC0C8\uB85C\uC6B4 \uC77C\uC5D4
        \uC18C\uC6D4\uC758 \uD754\uC801\uC774 \uB0A8\uC544\uC788\uC9C0 \uC54A\uC558\uC73C\uB2C8\uAE4C.\r\n\uD574\uC654\uB358
        \uC77C\uB4E4\uBCF4\uB2E4\uB3C4 \uC0C8\uB85C\uC6B4 \uC77C\uC744 \uD558\uACE0\uC2F6\uC5C8\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC0AC\uB78C\uB4E4\uC744 \uB9CE\uC774 \uB9CC\uB0AC\uB2E4.\r\n\uBB3C\uACE0\uAE30\uB97C
        \uC88B\uC544\uD574\uC11C \uC5B4\uBD80\uC5C5\uC744 \uD558\uB294 \uACF0 \uC218\uC778\uC778
        \uAC15\uD0DC\uACE4 \uC544\uC800\uC528.\r\n\uB9E4\uC77C\uAC19\uC774 \uD654\uC7A5\uD558\uB290\uB77C
        \uD654\uC7A5\uD488\uC774 \uD544\uC694\uD55C \uC18C\uB780.\r\n\uC774\uB984\uB3C4
        \uBAA8\uB974\uB294 \uC6C5\uBB18\uC871 \uBC25\uC9D1 \uC544\uC90C\uB9C8."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC7A5\uC0AC\uB294 \uC0AC\uB78C\uC744 \uBC8C\uACE0 \uC0AC\uB78C\uC73C\uB85C
        \uAD74\uB9AC\uB294\uAC70\uC600\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
