      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uB9C8\uC744 \uC18D\uC18D\uB4E4\uC774 \uB3CC\uC544\uB2E4\uB2C8\uBA70
        \uADF8\uB4E4\uC774 \uBB58 \uC798\uD558\uB294\uC9C0. \uC5B4\uB5A4 \uC77C\uC744
        \uD560 \uC218 \uC788\uB294\uC9C0 \uBB3C\uC5B4\uBD24\uACE0. \uB9CE\uC9C0\uB3C4
        \uC54A\uC740 \uB3C8\uC744 \uBAA8\uC544 \uADF8\uB4E4\uC5D0\uAC8C \uD22C\uC790\uD588\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
