      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC804\uB3C4\uC720\uB9DD\uD55C \uC624\uC18C\uB9AC \uB300\uC7A5\uC7A5\uC774\uC778
        \uC6B4\uB3C4\uC5D0\uAC90 \uAC15\uCCA0\uACFC \uB300\uC7A5\uAC04\uC744.\r\n\uC190\uC7AC\uC8FC\uAC00
        \uB6F0\uC5B4\uB09C \uC1A1\uACE8\uB9E4 \uC740\uC124\uC5D0\uAC90 \uC815\uAD50\uD55C
        \uB3C4\uAD6C\uC640 \uB3CB\uBCF4\uAE30\uB97C."
