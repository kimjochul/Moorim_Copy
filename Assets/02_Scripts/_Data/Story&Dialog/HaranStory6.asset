      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uADF8\uB4E4\uC740 \uB3C8\uACFC \uD658\uACBD\uC744 \uC8FC\uB294 \uB0B4\uAC8C
        \uAC10\uC0AC\uD588\uC9C0\uB9CC\r\n\uB0B4\uAC00 \uBC1B\uB294 \uC0C1\uD488\uB4E4\uC740
