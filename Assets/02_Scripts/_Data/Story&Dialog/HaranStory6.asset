      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC774\uC57C\u2026\uC798\uD558\uB124! \uB2C8 \uC5B4\uB514\uC11C \uC774\uB7F0
        \uC7AC\uC8FC\uB97C \uAC16\uACE0\uC654\uB178!"
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 2
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uB0B4\uB294 \uBB50 \uC548\uD588\uB2E4. \uC0AC\uB78C\uB4E4\uC774 \uB2E4
        \uD55C\uAC70\uC9C0.\r\n\uB09C \uBD80\uD0C1\uBC16\uC5D0 \uD55C\uAC8C \uC5C6\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 0
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 13
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uC5B4\uC9F8 \uB2CC \uAC00\uBA74 \uAC08\uC218\uB85D \uC544\uBC84\uC9C0\uCC98\uB7FC
        \uB9D0\uD558\uB124.\r\n\uB9D0\uB3C4 \uCC38 \uC774\uC058\uAC8C \uD558\uACE0.
        \uC544\uBC84\uC9C0\uB3C4 \uC54C\uBA74 \uC5C4\uCCAD \uAE30\uBED0\uD560\uAE30\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
      transitionSpeed: 0
    - id: 0
      lineType: 1
      illustrationOverride: {fileID: 0}
      illustrationSequence: []
      characterID: 0
      isUnknown: 0
      emotion: 0
      motion:
        type: 0
        duration: 0
        value: 0
      motions: []
      screenEffect:
        effectType: 0
        effectDuration: 1.5
        effectPower: 0
      line: "\uB450\uB2EC\uCBE4 \uB418\uB294 \uB54C\uC600\uB098. \uC77C\uC774 \uB298\uC5B4\uAC00\uBA74\uC11C
        \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC778\uC815\uBC1B\uAE30 \uC2DC\uC791\uD588\uB2E4."
      useTypingSound: 1
      isInnerThought: 0
      showEmotionIcon: 0
      useAccentFontSize: 0
      hideDialogueUI: 0
      autoNext: 0
      autoDelay: 0
      hideFromLog: 0
