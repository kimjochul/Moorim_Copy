  stories:
  - id: 0
    storyName: "\uBA54\uC778 1. \uCD9C\uC0AC\uD45C"
    story:
    - "\uC804\uC7C1\uC774 \uB05D\uB09C \uC9C0 \uBA87 \uD574\uAC00 \uC9C0\uB09C \uC5B4\uB290
      \uB0A0  \uBB34\uB9BC\uACFC \uC11C\uBC29\uC744 \uC787\uB294 \uAE38\uBAA9 \uD55C\uAC00\uC6B4\uB370,"
    - "\uC624\uB7AB\uB3D9\uC548 \uB2EB\uD600 \uC788\uB358 \uAC1D\uC794 \uD558\uB098\uAC00
      \uB2E4\uC2DC \uBB38\uC744 \uC5F4\uC5C8\uB2E4.  \uC774\uB984\uD558\uC5EC **\uBB34\uB9BC\uAC1D\uC794**."
    - "\uD55C\uB54C \uC5EC\uD589\uC790\uB4E4\uACFC \uBB34\uB9BC\uC778\uB4E4\uB85C
      \uBD90\uBE44\uB358 \uACF3\uC774\uC5C8\uC9C0\uB9CC  \uC804\uC7C1\uC774 \uC9C0\uB098\uAC04
      \uB4A4 \uAC74\uBB3C\uC758 \uC808\uBC18\uC774 \uBB34\uB108\uC84C\uACE0  \uC0AC\uB78C\uB4E4\uC740
      \uB2E4\uC2DC\uB294 \uC7A5\uC0AC\uB97C \uD560 \uC218 \uC5C6\uC744 \uAC83\uC774\uB77C
      \uC218\uAD70\uAC70\uB838\uB2E4."
  - id: 1
    storyName: "\uBA54\uC778 2. \uAC10\uAC10\uBB34\uC18C\uC2DD"
    story:
    - "\uAC00\uAC8C \uBB38\uC744 \uC5F0\uC9C0\uB3C4 \uC5B4\uC5F0 1\uB2EC.\r\n\r\n\uC7A5\uC0AC\uAC00
      \uC0DD\uAC01\uBCF4\uB2E4 \uC218\uC6D4\uD558\uAC8C \uC9C4\uD589\uB418\uC9C0
      \uC54A\uC544 \uBA85\uC6D4\uC740 \uD0C1\uC790\uC5D0 \uC549\uC544 \uACE0\uC2EC\uD55C\uB2E4."
    - "\uC624\uB77C\uB294 \uC190\uB2D8\uC740 \uC548\uC624\uACE0 \uD30C\uB9AC\uB9CC
      \uB208 \uC55E\uC5D0\uC11C \uC54C\uC9F1\uAC70\uB9AC\uC790 \uBA85\uC6D4\uC740
      \uBD84\uB178\uD558\uC5EC \uC560 \uBA3C \uD30C\uB9AC\uB97C \uC7A1\uB2E4\uAC00\r\n\r\n\uB118\uC5B4\uC838\uC11C
      \uC758\uC790 \uD558\uB098\uB97C \uBD80\uC234\uBC84\uB9AC\uACE0,"
