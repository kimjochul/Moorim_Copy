  talkButton: {fileID: 2308088775238823629}
  upgradeButton: {fileID: 0}
  exitButton: {fileID: 1901511531573004641}
  greetingDialogues:
  - "\uC5EC\uAE30 \uBA85\uC6D4\uC774 \uC18C\uC6D4\uC774 \uC788\uB098\uC694? \uC6B0\uD3B8
    \uC654\uC5B4\uC694"
  - "\uC6B0\uD3B8 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4~ \uAE30\uC05C \uC18C\uC2DD\uC774\uBA74
    \uC88B\uACA0\uB124\uC694!"
  idleDialogues:
  - "\uC694\uC998\uC740 \uD3B8\uC9C0\uBCF4\uB2E4 \uC18C\uBB38\uC774 \uB354 \uBE68\uB9AC
    \uB3C4\uB294 \uAC83 \uAC19\uC544\uC694."
  - "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uD3B8\uC9C0\uAC00 \uC816\uC9C0 \uC54A\uAC8C
    \uB354 \uC2E0\uACBD \uC368\uC57C \uD574\uC694."
  - "\uD3B8\uC9C0 \uD55C \uD1B5\uC5D0 \uB2F4\uAE34 \uB9C8\uC74C\uC740 \uC0DD\uAC01\uBCF4\uB2E4
    \uBB34\uAC81\uB2F5\uB2C8\uB2E4."
  - "\uC774 \uB3D9\uB124\uB294 \uB2E4\uB4E4 \uC5BC\uAD74\uC774 \uC775\uC5B4\uC11C
    \uC77C\uD558\uAE30 \uD3B8\uD574\uC694."
  - "\uAC00\uB054\uC740 \uC81C\uAC8C \uC624\uB294 \uD3B8\uC9C0\uB3C4 \uC788\uC5C8\uC73C\uBA74
    \uC88B\uACA0\uB124\uC694."
