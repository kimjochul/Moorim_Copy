  slotPrefab: {fileID: 3975568071313582283, guid: cbf4bdb992ba5d64b913a32a517dd6be, type: 3}
  buttonContent: {fileID: 690497001473510459}
  menuDatas:
  - buttonName: "\uC784\uBB34"
    state: 1
    expression:
      face: 4
      eyebrow: 1
      shadow: 0
      useDOScale: 1
  - buttonName: "\uAC1C\uB7C9"
    state: 4
    expression:
      face: 26
      eyebrow: 2
      shadow: 0
