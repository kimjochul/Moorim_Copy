  - buttonName: "\uB300\uD654"
    state: 2
    expression:
      face: 1
      eyebrow: 1
      shadow: 0
      useDOScale: 1
  characterSlot: {fileID: 690625013314240225}
  postmanCharacter: {fileID: 11400000, guid: a5913a1c26fe5f74b90488bac73ed188, type: 2}
  exitButton: {fileID: 1901511531573004641}
  saveButton: {fileID: 4149611506719013886}
  loadButton: {fileID: 5079399885914155335}
  greetingDialogues:
  - text: "\uC548\uB155\uD558\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4! \uC624\uB298\uB3C4
      \uD3B8\uC9C0\uB97C \uAC00\uC9C0\uACE0 \uC654\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4!"
    expression:
      face: 4
      eyebrow: 4
      shadow: 0
      useDOScale: 1
  - text: "\uC624\uB298\uB3C4 \uD3B8\uC9C0\uAC00 \uC654\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4
      \uAC1D\uC794 \uC8FC\uC778\uB2D8\uB4E4!"
    expression:
      face: 4
      eyebrow: 4
      shadow: 0
      useDOScale: 1
  idleDialogues:
  - text: "\uD3B8\uC9C0 \uD55C \uD1B5\uC5D0 \uB2F4\uAE34 \uB9C8\uC74C\uC740 \uC0DD\uAC01\uBCF4\uB2E4
      \uBB34\uAC81\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4."
    expression:
      face: 20
      eyebrow: 6
      shadow: 0
      useDOScale: 1
  - text: "\uAC00\uB054\uC740 \uC81C\uAC8C \uC624\uB294 \uD3B8\uC9C0\uB3C4 \uC788\uC5C8\uC73C\uBA74
      \uC88B\uACA0\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4."
    expression:
      face: 20
      eyebrow: 6
      shadow: 0
      useDOScale: 1
  - text: "\uB3C4\uB85C\uC2DC\uB3C4 \uBC30\uACE0\uD504\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4.
      \uC800\uB3C4 \uD55C \uADF8\uB987 \uBA39\uACE0\uC2F6\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4!"
    expression:
      face: 4
      eyebrow: 4
      shadow: 0
      useDOScale: 1
  - text: "\uC774 \uB3D9\uB124\uB294 \uB2E4\uB4E4 \uC5BC\uAD74\uC774 \uC775\uC5B4\uC11C
      \uCC3E\uC544\uAC00\uAE30 \uD3B8\uD558\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4."
    expression:
      face: 1
      eyebrow: 1
      shadow: 0
      useDOScale: 1
  - text: "\uD3B8\uC9C0\uB97C \uC81C\uC2DC\uAC04\uC5D0 \uBC30\uB2EC\uD558\uB294 \uAC83\uC774
      \uC6B0\uCCB4\uBD80\uC758 \uC790\uC874\uC2EC\uC774\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4!"
    expression:
      face: 26
      eyebrow: 4
      shadow: 0
      useDOScale: 1
